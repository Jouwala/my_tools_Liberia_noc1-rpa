# OpenClaw API 优选器 —— 密钥模板
# 复制为 .env 并填入你的密钥；脚本优先读环境变量，其次复用 openclaw.json 中已配置的密钥。
# 没有密钥的远端会被自动跳过（不会被选为主用）。
# 注意：.env 含有敏感信息，请勿提交到版本库。

# ---- 国内常用（免费档较友好）----
ZHIPU_API_KEY=
ZHIPU_GLM5_API_KEY=
SILICONFLOW_API_KEY=
MINIMAX_API_KEY=
MOONSHOT_API_KEY=
STEPFUN_API_KEY=

# ---- 国际免费/开源网关 ----
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_CLOUD_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
DEEPINFRA_API_KEY=
FIREWORKS_API_KEY=
GEMINI_API_KEY=

# ---- 付费或特殊 ----
OPENAI_API_KEY=
MISTRAL_API_KEY=
DAHL_API_KEY=
