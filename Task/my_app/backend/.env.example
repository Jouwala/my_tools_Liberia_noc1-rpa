# my_app 后端启动必需的最小配置模板
# 用法：复制成同目录下的 backend/.env（.env 已被 .gitignore 忽略），再填真实值。
# 依赖：pip install -r ../requirements.txt（psycopg2-binary / python-dotenv 已在其中）
# 真实值（数据库口令、OpenWebUI 账号、Kiosk 密钥）不进仓库，向 NOC 值班负责人索取。

# 数据库后端：pg = PostgreSQL（团队实际部署）；sqlite = 本地文件 db/app.db，离线调试时把
# 下面的 DATABASE_URL 留空即可（backend/database.py 里 MY_APP_DB_MODE 默认为 sqlite）
MY_APP_DB_MODE=pg

# 主库连接串，仅 MY_APP_DB_MODE=pg 时使用；未设置会启动即报错而非静默降级
DATABASE_URL=postgresql://<user>:<password>@<host>:<5432>/<dbname>

# 常驻会话（大屏/无人的机器）：GET /api/auth/kiosk?key=<此值>&next=/myapp/?page=cxo_dashboard
# 留空则该接口关闭（404）
MYAPP_KIOSK_KEY=<向负责人索取>

# OpenWebUI 问答转发（backend/services/openwebui_client.py）；缺 email/password 时该功能报错
OPENWEBUI_BASE_URL=http://<host>:<port>
OPENWEBUI_EMAIL=<账号>
OPENWEBUI_PASSWORD=<口令>
# 备用模型：本地 WorkBuddy 代理不可用时才走它
OPENWEBUI_MODEL=agnes-2.5-flash

# TT 分析主用模型：本地 WorkBuddy 代理 (codebuddy_proxy, OpenAI 兼容)，无需 key
# 未启动或调用失败时自动降级到上面的 OPENWEBUI_MODEL
WORKBUDDY_ENABLED=1
WORKBUDDY_BASE_URL=http://127.0.0.1:8788/v1
WORKBUDDY_MODEL=deepseek-v4.1-flash

# 会话有效期（秒）：8 小时活跃窗口；MAX_TTL=0 表示不额外封顶，Cookie 存活 30 天
MYAPP_SESSION_TTL=28800
MYAPP_SESSION_MAX_TTL=0
MYAPP_SESSION_COOKIE_MAX_AGE=2592000

# ============ eFlow P1 告警 WhatsApp 推送（任务 tt_alarm_whatsapp_alert）============
# 本任务的四项口径都可在页面上配置：「设置 → 任务配置 → eFlow P1 Alarm WhatsApp Push」，
# 写入 backend/services/tt_alert_whatsapp_config.json。
# 优先级：环境变量 > 配置文件 > 内置默认；且在模块导入期解析一次，
# 故页面保存后由 PUT /api/task-configs/{task_id} 重启 worker 分组才生效。
#
# 目标群组：逗号分隔的群名。留空会**回退到默认测试群 test123**，并在任务结果的
# group_fallback / errors 里显式告警 —— 刻意的：避免有人清空配置后生产 P1 告警静默消失。
TT_ALERT_WHATSAPP_GROUPS=

# 时间窗口（分钟）：取 alarm_occur_time 落在近 N 分钟内的单，默认 180（3 小时）
TT_ALERT_WINDOW_MINUTES=180

# 重报节流（分钟，双档，2026-10-08）：
#   · 有更新档：自上次发送以来工单**有更新**（有人在处理），距上次发送满该值才再推，默认 30
TT_ALERT_RESEND_MINUTES=30
#   · 无更新档：自上次发送以来工单**没更新**（一直没人动），距上次发送满该值即催推，默认 10
TT_ALERT_STALL_MINUTES=10

# 参与推送的级别（逗号分隔），默认仅 P1。要扩大推送面可改 P1,P2（无需改代码）。
# **留空 = 不限级别**（不是「全不推」）。
TT_ALERT_SEVERITIES=P1

# 告警码**白名单**（逗号分隔）。默认不含 99933，故 99933 默认不推；
# 把它填进来就会推。**留空 = 不限告警码**（全推，不是全不推）。
# 匹配走 norm_alarm_code() 归一化后判等，故库里 '99933' 与 '99933.0' 两种形态都能命中。
TT_ALERT_ALARM_CODES=

# 等待浏览器扩展回报的最长秒数（与 WHATSAPP_EXT_WAIT_SECONDS 同量级）
TT_ALERT_WAIT_SECONDS=600

# 候选单采样上限。显著大于真实候选量；命中上限时任务结果里会显式标记 truncated
TT_ALERT_QUERY_LIMIT=500

# 消息语言（zh / en）。消息由 whatsapp-kb-bot 的 TT 分析引擎渲染（含里程碑时间轴、
# 派单依据、SLA 时效），与群里机器人回答同源。告警发给利比里亚现场团队，默认 en。
TT_ALERT_LANG=en

# 分析引擎的子进程超时（秒）。引擎正常只需 0.3~0.5 秒（读 36k 行 SQLite + 两张规则表），
# 但**对磁盘 IO 竞争极其敏感**：与其它重 IO 任务并发时曾超过 60s（2026-09-29 实测，
# 28 核机器，纯属抢盘）。故默认给 120s 余量 —— 超时即降级到内置头部模板
# （消息从 ~30 行缩成 6 行，仍会发出并在任务结果 errors 里显式说明）。
TT_ALERT_ANALYZE_TIMEOUT=120

# 分析引擎脚本路径。默认取同级目录 Task/whatsapp-kb-bot/scripts/tt-analyze.py；
# 部署到目录布局不同的机器时用它覆盖。引擎不存在 → 任务降级到内置模板。
# TT_ALERT_ANALYZE_SCRIPT=

# SP 报表（sp_online_report_send / sp_email_details / sp_whatsapp_report）发往
# WhatsApp 群 WH&SP Management 的外发开关。缺省开启；设为 0/false/no/off 即暂停群发，
# 但邮件链路照常执行、发送代码保留（跳过按成功处理，不会把邮件任务标红）。
# 恢复群发改回 1 或删除本行，改完重启 worker 进程树生效。
# SP_WHATSAPP_ENABLED=1

# ================= DC server  alarm WhatsApp push（ume_alarm_whatsapp_alert）=================
# 上游 ZTE UME 网管坐标。默认 10.121.8.2:443。登录凭据在「设置 → 凭据」的
# 「ZTE UME 服务器网管」组维护（credential key = ume_alarm），**不写在本文件**。
# UME_ALARM_HOST=10.121.8.2
# UME_ALARM_PORT=443

# 登录绑定的 OpenStack 项目名（Keystone 项目 token 用）。默认 admin。
# UME_ALARM_PROJECT=admin

# 推送白名单：**精确「告警码:级别」对**，逗号分隔。只有完全匹配的组合才推。
# 留空 = 不过滤（全推）。告警码多形态（'89069' / '89069.0'）统一 norm_alarm_code 后判等。
# 页面「设置 → 任务配置 → DC server  alarm WhatsApp push」可改，这里的值优先于页面。
UME_ALARM_PAIRS=89029:major,89006:major

# 备用口径（仅当 UME_ALARM_PAIRS 留空时生效）：告警码集合 ∩ 级别集合。
# 一般不用；保留是为了不破坏「只想按码过滤」的旧配置。
# UME_ALARM_CODES=
# UME_ALARM_LEVELS=

# 目标 WhatsApp 群名（逗号分隔）。留空 = 回退测试群 test123 并在任务结果里告警。
UME_ALARM_WHATSAPP_GROUPS=*P1 OLR ZTE MS Manager*

# 催报间隔（分钟）：告警未清除时距上次成功发送满 N 分钟再通报一次（带 REMINDER 横幅）。
UME_ALARM_RESEND_MINUTES=10

# 首轮只登记不发送：1/true = 首次运行把当前存量告警只入库、不推送（防刷群）；
# 0/false = 首轮即推送。默认开。
UME_ALARM_BOOTSTRAP=1

# ================= Fiber Break 告警自动派单（eflow_fiber_assign）=================
# 派单等待时长（分钟）：告警升起后必须先存在满 N 分钟才派单（业务口径「告警发生到
# 选择超过 15 分钟，才要指派单子和发送 WhatsApp 消息」——不是一升起就派）。
# 留这段时间让短时闪断自然清除，避免建出无效 TT。配 0 = 恢复「一升起就派」。
# 页面「设置 → 任务配置 → Fiber Break 告警自动派单」可改，这里的值优先于页面。
FIBER_ASSIGN_MIN_AGE_MINUTES=15

# 触发窗口（分钟，告警存续时长的上界）：超过就不派，防积压告警一次性全派出去。
FIBER_ASSIGN_WINDOW_MINUTES=180

# 同一次故障的合并派单时间窗（分钟）：升起时间落在此窗口内的多条 fiber 告警
# 合并成一个 TT（组内最早那条建单，其余共用同一单号，通报列出涵盖站点）。
# 配 0 = 关闭合并（每条告警各派一单）。页面可改，这里的值优先于页面。
FIBER_ASSIGN_GROUP_WINDOW_MINUTES=10

# ================= 5G 站点告警自动派单（eflow_5g_assign）=================
# 与 Fiber 同一套引擎，差异在「告警码支持多个」+「一站多小区按站点合并」。
# 页面「设置 → 任务配置 → 5G 站点告警自动派单」可改，这里的值优先于页面。

# 告警码白名单（逗号分隔，支持任意多个）。留空回退内置 5 个 5G 退服类码：
# 200201001 DU cell out-of-service / 200201018 Super cell CP out-of-service /
# 200201041 gNodeB DU out-of-service / 200201043 NSA unavailable /
# 200201060 Super MIMO cell CP out-of-service
# EFLOW_5G_ASSIGN_ALARM_CODES=200201001,200201018,200201041,200201043,200201060

# 关联告警码：同站点同窗口已有该码 → 不重复派单。默认 99933。
EFLOW_5G_ASSIGN_CORRELATION_CODES=99933

# 派单等待时长（分钟，下界）：告警存续满 N 分钟才派单并推送（需求口径「15 分钟」）。
# 配 0 = 一升起就派。超过下面的窗口（上界）则不再派。
EFLOW_5G_ASSIGN_MIN_AGE_MINUTES=15
EFLOW_5G_ASSIGN_WINDOW_MINUTES=180

# 一站多小区合并窗（分钟）：同一站点、升起时间落在此窗口内的多条小区告警合并成
# 一个 TT。配 0 = 关闭合并（每个小区各派一单）。
EFLOW_5G_ASSIGN_GROUP_WINDOW_MINUTES=10

# 服务端按码过滤的候选 restype（eFlow 的 alarmcodeconds 必须带 restype，
# 且不支持通配）。默认已配 12 个常见 RAN restype；漏配某个码的 restype 会让它
# 永远拉不到且不报错 —— 全量审计会在 warnings 里点名，再补到这里。
# EFLOW_5G_ASSIGN_RESTYPES=zte.ran.gnodeb,zte.ran.nodeb,zte.ran.itbbu,...

# 演练模式：1 = 只匹配记录 + 渲染将发正文（dry_run_preview），不真派单。默认开。
EFLOW_5G_ASSIGN_DRY_RUN=1
