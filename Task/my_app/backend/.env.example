# my_app 后端启动必需的最小配置模板
# 用法：复制成同目录下的 backend/.env（.env 已被 .gitignore 忽略），再填真实值。
# 依赖：pip install -r ../requirements.txt（psycopg2-binary / python-dotenv 已在其中）
# 真实值（数据库口令、OpenWebUI 账号、Kiosk 密钥）不进仓库，向 NOC 值班负责人索取。

# 数据库后端：pg = PostgreSQL（团队实际部署）；sqlite = 本地文件 db/app.db，离线调试时把
# 下面的 DATABASE_URL 留空即可（backend/database.py 里 MY_APP_DB_MODE 默认为 sqlite）
MY_APP_DB_MODE=pg

# 主库连接串，仅 MY_APP_DB_MODE=pg 时使用；未设置会启动即报错而非静默降级
DATABASE_URL=postgresql://<user>:<password>@<host>:<5432>/<dbname>

# 常驻会话（大屏/无人的机器）：GET /api/auth/kiosk?key=<此值>&next=/myapp/?page=cxo_dashboard
# 留空则该接口关闭（404）
MYAPP_KIOSK_KEY=<向负责人索取>

# OpenWebUI 问答转发（backend/services/openwebui_client.py）；缺 email/password 时该功能报错
OPENWEBUI_BASE_URL=http://<host>:<port>
OPENWEBUI_EMAIL=<账号>
OPENWEBUI_PASSWORD=<口令>
# 备用模型：本地 WorkBuddy 代理不可用时才走它
OPENWEBUI_MODEL=agnes-2.5-flash

# TT 分析主用模型：本地 WorkBuddy 代理 (codebuddy_proxy, OpenAI 兼容)，无需 key
# 未启动或调用失败时自动降级到上面的 OPENWEBUI_MODEL
WORKBUDDY_ENABLED=1
WORKBUDDY_BASE_URL=http://127.0.0.1:8788/v1
WORKBUDDY_MODEL=deepseek-v4.1-flash

# 会话有效期（秒）：8 小时活跃窗口；MAX_TTL=0 表示不额外封顶，Cookie 存活 30 天
MYAPP_SESSION_TTL=28800
MYAPP_SESSION_MAX_TTL=0
MYAPP_SESSION_COOKIE_MAX_AGE=2592000

# ============ eFlow P1 告警 WhatsApp 推送（任务 tt_alarm_whatsapp_alert）============
# 本任务的四项口径都可在页面上配置：「设置 → 任务配置 → eFlow P1 Alarm WhatsApp Push」，
# 写入 backend/services/tt_alert_whatsapp_config.json。
# 优先级：环境变量 > 配置文件 > 内置默认；且在模块导入期解析一次，
# 故页面保存后由 PUT /api/task-configs/{task_id} 重启 worker 分组才生效。
#
# 目标群组：逗号分隔的群名。留空会**回退到默认测试群 test123**，并在任务结果的
# group_fallback / errors 里显式告警 —— 刻意的：避免有人清空配置后生产 P1 告警静默消失。
TT_ALERT_WHATSAPP_GROUPS=

# 时间窗口（分钟）：取 alarm_occur_time 落在近 N 分钟内的单，默认 180（3 小时）
TT_ALERT_WINDOW_MINUTES=180

# 重报节流（分钟，双档，2026-10-08）：
#   · 有更新档：自上次发送以来工单**有更新**（有人在处理），距上次发送满该值才再推，默认 30
TT_ALERT_RESEND_MINUTES=30
#   · 无更新档：自上次发送以来工单**没更新**（一直没人动），距上次发送满该值即催推，默认 10
TT_ALERT_STALL_MINUTES=10

# 参与推送的级别（逗号分隔），默认仅 P1。要扩大推送面可改 P1,P2（无需改代码）。
# **留空 = 不限级别**（不是「全不推」）。
TT_ALERT_SEVERITIES=P1

# 告警码**白名单**（逗号分隔）。默认不含 99933，故 99933 默认不推；
# 把它填进来就会推。**留空 = 不限告警码**（全推，不是全不推）。
# 匹配走 norm_alarm_code() 归一化后判等，故库里 '99933' 与 '99933.0' 两种形态都能命中。
TT_ALERT_ALARM_CODES=

# 等待浏览器扩展回报的最长秒数（与 WHATSAPP_EXT_WAIT_SECONDS 同量级）
TT_ALERT_WAIT_SECONDS=600

# 候选单采样上限。显著大于真实候选量；命中上限时任务结果里会显式标记 truncated
TT_ALERT_QUERY_LIMIT=500

# 消息语言（zh / en）。消息由 whatsapp-kb-bot 的 TT 分析引擎渲染（含里程碑时间轴、
# 派单依据、SLA 时效），与群里机器人回答同源。告警发给利比里亚现场团队，默认 en。
TT_ALERT_LANG=en

# 分析引擎的子进程超时（秒）。引擎正常只需 0.3~0.5 秒（读 36k 行 SQLite + 两张规则表），
# 但**对磁盘 IO 竞争极其敏感**：与其它重 IO 任务并发时曾超过 60s（2026-09-29 实测，
# 28 核机器，纯属抢盘）。故默认给 120s 余量 —— 超时即降级到内置头部模板
# （消息从 ~30 行缩成 6 行，仍会发出并在任务结果 errors 里显式说明）。
TT_ALERT_ANALYZE_TIMEOUT=120

# 分析引擎脚本路径。默认取同级目录 Task/whatsapp-kb-bot/scripts/tt-analyze.py；
# 部署到目录布局不同的机器时用它覆盖。引擎不存在 → 任务降级到内置模板。
# TT_ALERT_ANALYZE_SCRIPT=
