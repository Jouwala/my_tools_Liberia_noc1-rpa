{
  "manifest_version": 3,
  "name": "WhatsApp Image Sender",
  "description": "定时从 my_app 后端拉取 Site Outage 截图，在已登录的 WhatsApp Web 标签页中自动发送到配置好的群组。数据仅在本机与 WhatsApp 之间流转。",
  "version": "0.1.1",
  "permissions": ["storage", "alarms", "sidePanel", "scripting", "debugger", "downloads"],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "http://localhost/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:7038/*",
    "http://127.0.0.1:7038/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "WhatsApp Image Sender"
  }
}
