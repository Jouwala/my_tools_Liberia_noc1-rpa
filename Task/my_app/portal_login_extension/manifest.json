{
  "manifest_version": 3,
  "name": "my_app Portal Login",
  "description": "在受管 Chrome 中为 eFlow / RAIS / Battery UME 写入由 my_app 签发的一次性本机会话，不保存门户账号密码。",
  "version": "1.0.0",
  "minimum_chrome_version": "102",
  "permissions": ["cookies", "storage"],
  "host_permissions": [
    "http://192.168.100.20/*",
    "https://192.168.100.20/*",
    "https://10.100.20.8/*",
    "https://10.100.20.9/*",
    "https://192.168.170.2/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://192.168.100.20/myapp/*",
        "https://192.168.100.20/myapp/*"
      ],
      "js": ["myapp_bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://10.100.20.8/*"],
      "js": ["eflow_bootstrap.js"],
      "run_at": "document_start"
    }
  ]
}
