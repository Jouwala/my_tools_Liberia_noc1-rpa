# my_app 专属忽略规则
#
# 历史：本文件原先只有 venv 自动生成的两行（内容为 `*`），它把 my_app 下
# 所有未跟踪文件都屏蔽了 —— 包括新写的 backend 模块。git status 因此看不到
# 漏提交，已连续三周。现在改成显式列出真正该忽略的东西。

# 虚拟环境直接建在源码目录里（Lib 352M / Scripts 6.4M / include）
/Lib/
/Scripts/
/include/
/pyvenv.cfg
/.venv/
/.venv-test/

# 运行时数据（sqlite 956M / 日志 152M）
/db/
/log/

# IDE（根 .gitignore 未覆盖 .trae）
/.trae/

# 构建产物与编译中间件
/frontend/dist*/
*.class

# 进程锁文件
*.pid

# 鉴权缓存与本地凭据（含敏感信息，根规则同样覆盖，这里再显式写一次）
/auth_cache/
**/auth_cache/
*.local.json

# PM 性能数据下载缓存（zip+xml 成对，19 万量级，每次运行可重建）
/backend/services/cn_ems/_pmcache/

# SQLite 边车文件（根规则的 *.wal 匹配不到 "xxx.sqlite3-wal" 这种连字符命名）
*-wal
*-shm

# 带时间戳的库备份与运行时整目录备份
*.bak_*
/backend/services/cn_ems/jab_setup/backup_*/

# 任务运行产出（每次运行重写，入库只会造成永久 diff 噪声）
/backend/services/cn_ems/daily_raw.json
/backend/services/cn_ems/kpi_result.json
/backend/services/cn_ems/kpi_result_raw.json
/backend/services/cn_ems/pm_query_template.bin
/backend/services/eflow_rules/eflow_tt_rules_check_latest.json
_probe_file.txt

# 临时产物目录（截图 / 抓包 / 一次性探针脚本 / Chrome 临时 profile）
# 服务在用的 TMP/ccn_free_rating_charts、fw_charts、ipran_charts、email_recovery_state.json
# 同属运行时产出，一并忽略。
/TMP/

# 代码清洁归档目录（同盘移动，确认无碍后整体删除）
/_myapp_trash_*/

# 误建的空 sqlite 占位（真正库是 /db/app.db）
/backend/app.db

# 原生看板磁盘缓存（运行时产物，可由源库重建；单页 JSON 可达数 MB）
# 见 backend/services/dashboard_service.py 的 CACHE_DIR
/backend/data/native_board_cache/

# Chrome 临时 profile（portal_login_service 正常退出时会自清，异常退出会残留）
/data/portal_profiles/_tmp_*/

# 根目录一次性探针脚本禁止入库（2026-09-18 清理：98 个误随 2177afa 入库的 _tmp_* 已归档到 _myapp_trash_20260918/）
/_tmp_*
