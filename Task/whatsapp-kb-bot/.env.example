# 复制为 .env 后按需修改（也可直接改 config.json，二者等效，环境变量优先）
# 加载方式：npm start 已内置；手工运行请用 node --env-file-if-exists=.env src/index.js

# ============ 对话模型 provider ============
# ollama = 全本地；openai = 任意 OpenAI 兼容接口（Agnes AI / 各云厂商）
CHAT_PROVIDER=openai

# 云端 provider 的模型名与接口地址
# 当前配置：WorkBuddy 本地代理（start-workbuddy-chain.ps1 启动，端口 8788）
# 切回 Agnes: CHAT_MODEL=agnes-3.0-flash, CHAT_BASE_URL=https://apihub.agnes-ai.com/v1
CHAT_MODEL=deepseek-v4.1-flash
CHAT_BASE_URL=http://127.0.0.1:8788/v1

# 密钥。推荐用环境变量而不是写进 config.json —— 后者容易被误提交。
# config.json 的 chatApiKeyEnv 决定读哪个变量名（默认 AGNES_API_KEY）。
# WorkBuddy 代理（8788）用 WorkBuddy session 鉴权，此字段随意填即可。
# 真实密钥请只写在 .env 里（.env 不进版本库）。本文件是模板，不要填真值。
AGNES_API_KEY=
CHAT_TIMEOUT_MS=60000

# Thinking（思维链）模式：知识库问答不需要，开启只会白烧 token 预算，
# 极端情况下思考把预算吃光会让 content 返回空串。
# 0=显式关闭  1=显式开启  留空/删除=不传该参数，用服务端默认
ENABLE_THINKING=0

# 单次回答的最大输出 token 数
MAX_TOKENS=512

# ============ 本地嵌入（始终走 Ollama，资料不出本机）============
OLLAMA_URL=http://127.0.0.1:11434
EMBED_MODEL=bge-m3:latest

# ============ 路径 ============
KNOWLEDGE_DIR=knowledge
INDEX_PATH=data/index.json
AUTH_DIR=data/auth

# ============ 检索参数 ============
# 注意：这里留空/注释掉就用 config.json 的值。填了会覆盖它。
# 务必用 npm run calibrate 在本机语料上重新校准，不要照搬。
#TOP_K=6
#MIN_ABS=0.43
#MIN_GAP=0.05
#SEMANTIC_WEIGHT=0.78
#LEXICAL_WEIGHT=0.22
#ID_BONUS=0.15

# TT 单分析（查 my_app 工单库）
#TT_PYTHON=C:/Users/ZTEEMS/AppData/Local/Programs/Python/Python312/python.exe
#TT_TIMEOUT_MS=25000

# my_app 根目录。**一般不用设**：脚本会自动定位（默认找与本项目并列的
# <工作区>/Task/my_app，与盘符无关）。只有当 my_app 装在别处时才需要显式指定，
# 例如 MY_APP_DIR=D:/01_RPA/Task/my_app
#MY_APP_DIR=

# 同一会话内两次回复的最小间隔（毫秒），用于降低触发风控的概率
COOLDOWN_MS=4000

# 打印检索诊断信息
DEBUG_RAG=0
