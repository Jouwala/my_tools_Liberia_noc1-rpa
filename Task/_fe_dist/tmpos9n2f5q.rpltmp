<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MW UME 微波网络拓扑 NOC 看板</title>
<style>
  :root{
    --bg:#03141d; --panel:#0a2330; --panel2:#0d2b3b; --text:#e7f3f8; --muted:#8fb3c4;
    --line:rgba(255,255,255,.08); --accent:#19c3ff;
    --green:#27d39a; --yellow:#ffd43b; --orange:#ff922b; --red:#ff6b6b; --gray:#64748b;
  }
  html[data-theme="light"]{
    --bg:#eef3f8; --panel:#ffffff; --panel2:#f4f8fc; --text:#16233b; --muted:#5b7288;
    --line:rgba(22,35,59,.12); --accent:#0e7490;
    --green:#0f9d6b; --yellow:#b45309; --orange:#c2410c; --red:#d92d20; --gray:#94a3b8;
  }
  *{box-sizing:border-box; margin:0; padding:0}
  html,body{height:100%}
  body{
    background:var(--bg); color:var(--text); font-family:"Segoe UI","Microsoft YaHei",system-ui,sans-serif;
    display:flex; flex-direction:column; overflow:hidden; font-size:13px;
  }
  /* ---------- header ---------- */
  header{
    display:flex; align-items:center; gap:12px; padding:8px 14px; background:var(--panel);
    border-bottom:1px solid var(--line); flex:0 0 auto; flex-wrap:wrap;
  }
  header h1{font-size:15px; font-weight:600; letter-spacing:.3px; white-space:nowrap}
  header h1 span{color:var(--accent)}
  .meta{color:var(--muted); font-size:12px; white-space:nowrap}
  .spacer{flex:1}
  .status-pill{font-size:11px; padding:2px 8px; border-radius:10px; background:var(--panel2);
    border:1px solid var(--line); color:var(--muted); white-space:nowrap}
  .status-pill.ok{color:var(--green); border-color:var(--green)}
  .status-pill.warn{color:var(--yellow); border-color:var(--yellow)}
  .status-pill.err{color:var(--red); border-color:var(--red)}
  .btn{
    background:var(--panel2); color:var(--text); border:1px solid var(--line); border-radius:6px;
    padding:3px 10px; font-size:12px; cursor:pointer; white-space:nowrap;
  }
  .btn:hover{border-color:var(--accent); color:var(--accent)}
  .btn.active{background:var(--accent); color:#fff; border-color:var(--accent)}
  .btn.icon{font-size:14px; line-height:1; padding:3px 8px; font-weight:600}
  /* 拓扑图最大化（组件级全屏覆盖 iframe） */
  #topo-wrap.max{
    position:fixed; inset:14px; z-index:120; background:var(--panel);
    border-radius:12px; box-shadow:0 10px 40px rgba(0,0,0,.45);
  }
  #topo-wrap.max #topo-head{border-bottom:1px solid var(--line)}
  /* 浏览器全屏时的底色 */
  body:fullscreen{background:var(--bg)}
  select,input[type="search"]{
    background:var(--panel2); color:var(--text); border:1px solid var(--line); border-radius:6px;
    padding:3px 8px; font-size:12px; outline:none;
  }
  input[type="search"]{width:150px}
  .lbl{color:var(--muted); font-size:12px; white-space:nowrap}
  /* ---------- KPI row ---------- */
  #kpis{
    display:grid; grid-template-columns:repeat(7,1fr); gap:10px; padding:10px 14px; flex:0 0 auto;
  }
  .kpi{background:var(--panel); border:1px solid var(--line); border-radius:10px; padding:8px 12px}
  .kpi .k-label{color:var(--muted); font-size:11px; letter-spacing:.4px; text-transform:uppercase}
  .kpi .k-val{font-size:24px; font-weight:700; line-height:1.2; font-variant-numeric:tabular-nums}
  .kpi .k-sub{font-size:11px; color:var(--muted); white-space:nowrap; overflow:hidden; text-overflow:ellipsis}
  .kpi.green .k-val{color:var(--green)} .kpi.yellow .k-val{color:var(--yellow)}
  .kpi.orange .k-val{color:var(--orange)} .kpi.red .k-val{color:var(--red)}
  .kpi.blue .k-val{color:var(--accent)}
  /* ---------- main body ---------- */
  #main{flex:1; display:flex; gap:10px; padding:0 14px 10px; min-height:0}
  #left{flex:1; display:flex; flex-direction:column; gap:10px; min-width:0; min-height:0}
  #topo-wrap{flex:1; background:var(--panel); border:1px solid var(--line); border-radius:10px;
    display:flex; flex-direction:column; min-height:0; position:relative}
  #topo-head{display:flex; align-items:center; gap:10px; padding:6px 12px; border-bottom:1px solid var(--line); flex:0 0 auto}
  #topo-head h3{font-size:13px; font-weight:600}
  #topo{flex:1; min-height:0}
  #topo-hint{position:absolute; right:10px; bottom:8px; font-size:11px; color:var(--muted); pointer-events:none}
  #right{width:320px; flex:0 0 auto; display:flex; flex-direction:column; gap:10px; min-height:0}
  #risks{flex:1; background:var(--panel); border:1px solid var(--line); border-radius:10px;
    display:flex; flex-direction:column; min-height:0}
  #risks h3{font-size:13px; font-weight:600; padding:8px 12px; border-bottom:1px solid var(--line)}
  #risk-list{flex:1; overflow-y:auto; padding:6px}
  .risk-item{
    display:flex; align-items:center; gap:8px; padding:6px 8px; border-radius:8px; cursor:pointer;
    border:1px solid transparent;
  }
  .risk-item:hover{background:var(--panel2); border-color:var(--line)}
  .risk-item.sel{background:var(--panel2); border-color:var(--accent)}
  .risk-item .dot{width:9px; height:9px; border-radius:50%; flex:0 0 auto}
  .risk-item .r-main{flex:1; min-width:0}
  .risk-item .r-name{font-size:12px; font-weight:600; white-space:nowrap; overflow:hidden; text-overflow:ellipsis}
  .risk-item .r-sub{font-size:11px; color:var(--muted); white-space:nowrap; overflow:hidden; text-overflow:ellipsis}
  .risk-item .r-pct{font-size:15px; font-weight:700; font-variant-numeric:tabular-nums; flex:0 0 auto}
  .risk-item .r-txrx{font-size:10px; color:var(--muted); flex:0 0 auto; text-align:right; line-height:1.3}
  /* ---------- bottom ---------- */
  #bottom{flex:0 0 auto; display:flex; gap:10px; padding:0 14px 10px}
  .card{background:var(--panel); border:1px solid var(--line); border-radius:10px; padding:8px 12px; flex:1}
  .card h3{font-size:13px; font-weight:600; margin-bottom:6px}
  .chart{width:100%}
  /* ---------- drawer (link details) ---------- */
  #drawer{
    position:fixed; top:0; right:-460px; width:420px; height:100%; background:var(--panel);
    border-left:1px solid var(--line); box-shadow:-8px 0 24px rgba(0,0,0,.35); z-index:100;
    transition:right .28s ease; display:flex; flex-direction:column;
  }
  #drawer.open{right:0}
  #drawer-head{
    display:flex; align-items:center; padding:14px 18px; border-bottom:1px solid var(--line);
  }
  #drawer-head h3{font-size:14px; font-weight:600; letter-spacing:.8px; flex:1}
  #drawer-close{
    background:transparent; border:none; color:var(--muted); font-size:18px; cursor:pointer; padding:4px 8px; line-height:1;
  }
  #drawer-close:hover{color:var(--text)}
  #drawer-body{flex:1; overflow-y:auto; padding:14px 18px}
  #drawer-mask{position:fixed; inset:0; background:rgba(0,0,0,.35); z-index:99; display:none}
  #drawer-mask.open{display:block}
  /* status pill */
  .d-pill{
    display:inline-flex; align-items:center; gap:6px; padding:3px 12px; border-radius:14px;
    font-size:12px; font-weight:700; letter-spacing:.5px; text-transform:uppercase;
  }
  .d-pill .dot{width:7px; height:7px; border-radius:50%}
  /* total capacity */
  .d-cap{font-size:36px; font-weight:800; line-height:1.05; margin-top:10px; font-variant-numeric:tabular-nums}
  .d-cap .u{font-size:16px; color:var(--muted); font-weight:600; margin-left:4px}
  .d-cap-label{font-size:11px; color:var(--muted); text-transform:uppercase; letter-spacing:.6px; margin-top:4px}
  /* endpoints */
  .d-ep{display:flex; align-items:center; gap:10px; margin-top:14px; margin-bottom:6px}
  .d-ep-card{flex:1; background:var(--panel2); border:1px solid var(--line); border-radius:8px; padding:9px 10px; min-width:0}
  .d-ep-icon{font-size:14px; color:var(--muted); margin-bottom:3px}
  .d-ep-name{font-size:12px; font-weight:600; word-break:break-all; line-height:1.25}
  .d-ep-arrow{color:var(--accent); font-size:20px; flex:0 0 auto}
  .d-ep-row{display:grid; grid-template-columns:1fr 1fr; gap:6px; margin-top:6px; margin-bottom:14px}
  .d-ep-row .d-cell{background:var(--panel2); border:1px solid var(--line); border-radius:8px; padding:7px 10px}
  .d-ep-row .d-cell .k{font-size:10px; color:var(--muted); text-transform:uppercase; letter-spacing:.4px; margin-bottom:2px}
  .d-ep-row .d-cell .v{font-size:12px; font-weight:600; font-family:Consolas,monospace; word-break:break-all}
  /* TX / RX blocks */
  .d-trx{display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-bottom:14px}
  .d-tr{
    border:1px solid var(--line); border-radius:10px; padding:10px 12px; position:relative; overflow:hidden;
  }
  .d-tr.tx{background:linear-gradient(135deg, rgba(255,107,107,.14) 0%, rgba(255,107,107,.04) 100%); border-color:rgba(255,107,107,.4)}
  .d-tr.rx{background:linear-gradient(135deg, rgba(39,211,154,.14) 0%, rgba(39,211,154,.04) 100%); border-color:rgba(39,211,154,.4)}
  .d-tr-title{font-size:11px; font-weight:700; letter-spacing:.5px; text-transform:uppercase; color:var(--muted); display:flex; align-items:center; gap:6px}
  .d-tr.tx .d-tr-title{color:#ff6b6b}
  .d-tr.rx .d-tr-title{color:#27d39a}
  .d-tr-val{font-size:22px; font-weight:700; line-height:1.1; margin-top:4px; font-variant-numeric:tabular-nums}
  .d-tr-sub{font-size:10px; color:var(--muted); margin-top:2px}
  .d-tr-u{font-size:14px; font-weight:700; margin-top:6px; font-variant-numeric:tabular-nums}
  .d-tr.u-crit{color:#ff6b6b} .d-tr.u-warn{color:#ff922b} .d-tr.u-watch{color:#ffd43b} .d-tr.u-ok{color:#27d39a}
  /* trend */
  .d-trend-card{
    border:1px solid var(--line); border-radius:10px; padding:10px 12px; margin-bottom:14px;
  }
  .d-trend-title{font-size:11px; color:var(--muted); text-transform:uppercase; letter-spacing:.5px; display:flex; align-items:center; gap:6px; margin-bottom:6px}
  .d-trend{width:100%; height:140px}
  .d-trend-note{font-size:10px; color:var(--muted); margin-top:4px; line-height:1.4}
  /* action buttons */
  .d-actions{display:flex; gap:8px; margin-top:8px}
  .d-actions .btn{flex:1; padding:7px 10px; font-size:12px; font-weight:600}
  .d-endpoints-hint{font-size:10px; color:var(--muted); margin-top:-6px; margin-bottom:14px}
  .d-cps-hint{font-size:10px; color:var(--muted); margin-top:6px}
  .d-cps{margin-top:6px}
  .badge{font-size:10px; padding:1px 6px; border-radius:8px; margin-left:6px; vertical-align:middle}
  .lvl-healthy{color:var(--green)} .lvl-watch{color:var(--yellow)}
  .lvl-warning{color:var(--orange)} .lvl-critical{color:var(--red)} .lvl-unknown{color:var(--gray)}
  .dot-healthy{background:var(--green)} .dot-watch{background:var(--yellow)}
  .dot-warning{background:var(--orange)} .dot-critical{background:var(--red)} .dot-unknown{background:var(--gray)}
  .empty{color:var(--muted); text-align:center; padding:30px 10px; font-size:12px}
  /* scrollbar */
  ::-webkit-scrollbar{width:8px; height:8px}
  ::-webkit-scrollbar-thumb{background:var(--line); border-radius:4px}
  ::-webkit-scrollbar-track{background:transparent}
  /* Leaflet 在线地图容器（geo 模式） */
  #topo-leaflet{ position:absolute; inset:0; display:none; z-index:1; background:#0b1620; }
  #topo-leaflet .leaflet-container{ background:#0b1620; }
  #topo-leaflet .leaflet-control-attribution{ font-size:10px; background:rgba(0,0,0,.5); color:#9fb3c8; }
  #topo-leaflet .leaflet-control-attribution a{ color:#19c3ff; }
  /* KPI 卡可点击 */
  .kpi{cursor:pointer; transition:transform .12s ease, box-shadow .12s ease; position:relative}
  .kpi:hover{transform:translateY(-1px); box-shadow:0 4px 14px rgba(0,0,0,.25)}
  .kpi .k-why{position:absolute; top:6px; right:8px; width:16px; height:16px; border-radius:50%;
    background:rgba(255,255,255,.08); color:var(--muted); font-size:11px; font-weight:700; line-height:16px;
    text-align:center; opacity:.6; transition:opacity .12s}
  .kpi:hover .k-why{opacity:1; background:rgba(25,195,255,.18); color:var(--accent)}
  /* KPI 弹窗表格（Antd dark 风格） */
  #kpi-modal-mask{position:fixed; inset:0; background:rgba(0,0,0,.5); z-index:200; display:none}
  #kpi-modal-mask.open{display:block}
  #kpi-modal{position:fixed; top:7vh; left:50%; transform:translateX(-50%);
    width:min(980px, 94vw); max-height:86vh; background:var(--panel); border:1px solid var(--line);
    border-radius:10px; box-shadow:0 14px 48px rgba(0,0,0,.55); z-index:201; display:none;
    flex-direction:column; overflow:hidden}
  #kpi-modal.open{display:flex}
  #kpi-modal-head{display:flex; align-items:center; padding:12px 18px; border-bottom:1px solid var(--line); gap:10px}
  #kpi-modal-head h3{font-size:14px; font-weight:600; letter-spacing:.4px; flex:1}
  #kpi-modal-meta{color:var(--muted); font-size:11px}
  #kpi-modal-close{background:transparent; border:none; color:var(--muted); font-size:20px; cursor:pointer; padding:4px 10px; line-height:1}
  #kpi-modal-close:hover{color:var(--text)}
  #kpi-modal-body{flex:1; overflow:auto}
  .kpi-tbl{width:100%; border-collapse:separate; border-spacing:0; font-size:12px}
  .kpi-tbl th, .kpi-tbl td{padding:7px 10px; text-align:left; border-bottom:1px solid var(--line); vertical-align:middle}
  .kpi-tbl th{position:sticky; top:0; background:var(--panel2); color:var(--muted); font-weight:600; letter-spacing:.3px; font-size:10.5px; text-transform:uppercase; z-index:1}
  .kpi-tbl tr.kpi-row{cursor:pointer}
  .kpi-tbl tr.kpi-row:hover td{background:var(--panel2)}
  .kpi-tbl td.num{color:var(--muted); font-variant-numeric:tabular-nums; width:38px}
  .kpi-tbl td.pct{font-weight:700; font-variant-numeric:tabular-nums}
  .kpi-tbl td.mono{font-family:Consolas,monospace; font-size:11px}
  .kpi-tbl-status{display:inline-block; padding:2px 8px; border-radius:10px; font-size:10px; font-weight:700; letter-spacing:.5px; color:#fff}
  .kpi-tbl-empty{text-align:center; padding:40px; color:var(--muted); font-size:12px}
  .kpi-help{margin:10px 14px 0; padding:10px 12px; border:1px solid var(--line); border-radius:6px;
    background:var(--panel2); font-size:11px; color:var(--muted); line-height:1.55}
  .kpi-help b{color:var(--accent); font-weight:600}
  .kpi-tooltip{position:absolute; left:50%; bottom:calc(100% + 8px); transform:translateX(-50%);
    background:rgba(3,20,29,.96); color:var(--text); padding:8px 12px; border-radius:6px;
    font-size:11px; line-height:1.5; max-width:280px; width:max-content; box-shadow:0 4px 14px rgba(0,0,0,.4);
    border:1px solid rgba(25,195,255,.3); pointer-events:none; opacity:0; transition:opacity .12s; z-index:50}
  .kpi:hover .kpi-tooltip{opacity:1}
  /* 主题适配：深色主题对 OSM 瓦片做暗色滤镜，浅色主题用浅底 */
  #topo-leaflet .leaflet-tile-pane{ filter:none; transition:filter .3s ease; }
  #topo-leaflet.dark-map .leaflet-tile-pane{ filter:brightness(.62) invert(1) contrast(3) hue-rotate(200deg) saturate(.4) brightness(.72); }
  #topo-leaflet.light-map{ background:#dbe6f0; }
  #topo-leaflet.light-map .leaflet-container{ background:#dbe6f0; }
  /* 级别多选下拉 */
  .msel{position:relative; display:inline-block}
  .msel .btn{padding:4px 10px; font-size:12px}
  .msel-menu{position:absolute; top:100%; right:0; margin-top:4px; background:var(--panel); border:1px solid var(--line);
    border-radius:8px; box-shadow:0 6px 20px rgba(0,0,0,.35); padding:6px; z-index:50; min-width:172px; display:none}
  .msel-menu .chk{display:flex; align-items:center; gap:6px; padding:4px 6px; font-size:12px; cursor:pointer; white-space:nowrap}
  .msel-menu .chk:hover{background:var(--panel2); border-radius:6px}
  #risk-search{margin:6px 12px; padding:5px 8px; font-size:12px; border:1px solid var(--line); border-radius:6px;
    background:var(--panel2); color:var(--text); width:calc(100% - 24px); box-sizing:border-box; outline:none}
  #risk-search:focus{border-color:var(--accent)}
  #btn-geo-label{display:none}  /* 默认隐藏，仅地理模式显示 */
</style>
  <link rel="stylesheet" href="./lib/leaflet/leaflet.css">
  <style>
    /* 地理模式：链路流量动画（沿站点→站点方向流动的虚线） */
    .flow-line { stroke-dasharray: 2 10; animation: flowMove 3s linear infinite; }
    @keyframes flowMove { from { stroke-dashoffset: 0; } to { stroke-dashoffset: -12; } }
    .geo-marker { background: transparent !important; border: none !important; }
/* 站点节点：dot 位于 divIcon 中心 (iconSize=9, iconAnchor=4.5,4.5)，与链路端点精确对齐 */
  .geo-node { display:inline-flex; align-items:center; gap:3px; white-space:nowrap; }
  .geo-dot { width:9px; height:9px; border-radius:50%; display:inline-block; border:1px solid rgba(255,255,255,.75); }
    .geo-name { color:#e6f0f7; font:600 11px/1 system-ui,'Segoe UI',sans-serif; text-shadow:0 1px 2px #000,0 0 3px #000; }
    .geo-ip { color:#9fb3c2; font:400 9px/1 system-ui,sans-serif; text-shadow:0 1px 2px #000; }
    .geo-cluster { display:inline-block; padding:2px 7px; border-radius:12px; background:rgba(8,26,40,.88);
      border:1px solid #19c3ff; color:#19c3ff; font:700 11px/1 system-ui,sans-serif; box-shadow:0 0 8px rgba(25,195,255,.5); white-space:nowrap; }
  </style>
</head>
<body>
  <header>
    <h1>MW UME <span data-i18n="app.subtitle">微波网络拓扑</span> NOC</h1>
    <span class="meta" id="meta-date">—</span>
    <span class="meta" id="meta-gran" data-i18n="app.gran">1 Day</span>
    <span class="spacer"></span>
    <span class="lbl" data-i18n="topo.layout">布局</span>
    <button id="btn-force" class="btn" data-i18n="topo.force">逻辑拓扑</button>
    <button id="btn-geo" class="btn active" data-i18n="topo.geo">地理拓扑</button>
    <div class="msel" id="level-msel">
      <button type="button" class="btn" id="btn-level"><span data-i18n="topo.level">级别</span> ▾</button>
      <div class="msel-menu" id="level-menu">
        <label class="chk"><input type="checkbox" id="lv-all" checked> <span data-i18n="topo.lvlAll">全部</span></label>
        <label class="chk"><input type="checkbox" id="lv-critical" value="critical"> <span data-i18n="topo.lvlCrit">Critical &gt;85%</span></label>
        <label class="chk"><input type="checkbox" id="lv-warning" value="warning"> <span data-i18n="topo.lvlWarn">Major 70-85%</span></label>
        <label class="chk"><input type="checkbox" id="lv-watch" value="watch"> <span data-i18n="topo.lvlWatch">Minor 50-70%</span></label>
        <label class="chk"><input type="checkbox" id="lv-healthy" value="healthy"> <span data-i18n="topo.lvlOk">Healthy &lt;50%</span></label>
      </div>
    </div>
    <label class="lbl"><input type="checkbox" id="chk-label" style="vertical-align:middle"> <span data-i18n="topo.label">TX/RX 标签</span></label>
    <label class="lbl" title="折叠/展开逻辑拓扑 ACCESS 层"><input type="checkbox" id="chk-access" checked style="vertical-align:middle"> <span data-i18n="topo.access">ACCESS 层</span></label>
    <button id="btn-geo-label" class="btn" data-i18n="topo.geoLabel">站点名</button>
    <input type="search" id="inp-search" data-i18n-ph="topo.search" placeholder="搜索站点 / IP…">
    <button id="btn-refresh" class="btn" data-i18n="topo.refresh">刷新</button>
    <button id="btn-fs" class="btn icon" title="全屏" data-i18n-title="fs.title">⛶</button>
    <span class="status-pill" id="status">loading…</span>
  </header>

  <div id="kpis">
    <div class="kpi blue" data-kpi="nodes" data-why="nodes"><span class="k-why" title="?">?</span><div class="k-label" data-i18n="kpi.nodes">Network Nodes</div><div class="k-val" id="k-nodes">—</div><div class="k-sub" id="k-nodes-sub" data-i18n="kpi.nodesSub">全网网元</div><div class="kpi-tooltip" data-i18n="why.nodes">链路上的网元(站 + 端口)数量</div></div>
    <div class="kpi blue" data-kpi="links" data-why="links"><span class="k-why" title="?">?</span><div class="k-label" data-i18n="kpi.links">Links</div><div class="k-val" id="k-links">—</div><div class="k-sub" id="k-links-sub" data-i18n="kpi.linksSub">链路</div><div class="kpi-tooltip" data-i18n="why.links">ME↔Neighbor ME 唯一链路对数（每条链路 1 个）</div></div>
    <div class="kpi green" data-kpi="healthy" data-why="healthy"><span class="k-why" title="?">?</span><div class="k-label" data-i18n="kpi.healthy">Healthy</div><div class="k-val" id="k-healthy">—</div><div class="k-sub" data-i18n="kpi.lt50">&lt; 50%</div><div class="kpi-tooltip" data-i18n="why.linkLevel">链路级：聚合所有端口对(PM Checkpoint)的 max(TX%,RX%)，&lt;50% 计 1 条</div></div>
    <div class="kpi yellow" data-kpi="watch" data-why="watch"><span class="k-why" title="?">?</span><div class="k-label" data-i18n="kpi.watch">Minor</div><div class="k-val" id="k-watch">—</div><div class="k-sub" data-i18n="kpi.r5070">50 – 70%</div><div class="kpi-tooltip" data-i18n="why.linkLevel">链路级：聚合所有端口对的 max(TX%,RX%)，50–70% 计 1 条</div></div>
    <div class="kpi orange" data-kpi="warning" data-why="warning"><span class="k-why" title="?">?</span><div class="k-label" data-i18n="kpi.warning">Major</div><div class="k-val" id="k-warning">—</div><div class="k-sub" data-i18n="kpi.r7085">70 – 85%</div><div class="kpi-tooltip" data-i18n="why.linkLevel">链路级：聚合所有端口对的 max(TX%,RX%)，70–85% 计 1 条</div></div>
    <div class="kpi red" data-kpi="critical" data-why="critical"><span class="k-why" title="?">?</span><div class="k-label" data-i18n="kpi.critical">Critical</div><div class="k-val" id="k-critical">—</div><div class="k-sub" data-i18n="kpi.gt85">&gt; 85%</div><div class="kpi-tooltip" data-i18n="why.linkLevel">链路级：聚合所有端口对的 max(TX%,RX%)，&gt;85% 计 1 条</div></div>
    <div class="kpi red" data-kpi="max" data-why="max"><span class="k-why" title="?">?</span><div class="k-label" data-i18n="kpi.max">Max Utilization</div><div class="k-val" id="k-max">—</div><div class="k-sub" id="k-max-sub">—</div><div class="kpi-tooltip" data-i18n="why.max">全网利用率最高的单条链路</div></div>
  </div>

  <div id="main">
    <div id="left">
      <div id="topo-wrap">
        <div id="topo-head">
          <h3 data-i18n="topo.title">网络拓扑</h3>
          <span class="status-pill" id="topo-count">—</span>
          <span class="spacer"></span>
          <span class="lbl" style="font-size:11px" data-i18n="topo.hint">滚轮缩放 · 拖拽平移 · 悬停查看 · 点击链路看详情</span>
          <button id="btn-topo-max" class="btn icon" title="最大化" data-i18n-title="fs.max">⛶</button>
        </div>
        <div id="topo"></div>
        <div id="topo-leaflet"></div>
        <div id="topo-hint"></div>
      </div>
    </div>
    <div id="right">
      <div id="risks">
        <h3><span data-i18n="risks.title">Top Risk Links</span> <span id="risk-count" style="color:var(--muted);font-weight:400;font-size:11px"></span> <span style="color:var(--muted);font-weight:400;font-size:11px" data-i18n="risks.hint">— 点击定位到拓扑</span></h3>
        <input type="search" id="risk-search" data-i18n-ph="risks.search" placeholder="过滤 Critical 站点…">
        <div id="risk-list"><div class="empty" data-i18n="risks.empty">加载中…</div></div>
      </div>
    </div>
  </div>

  <div id="bottom">
    <div class="card" style="flex:1.4">
      <h3><span data-i18n="trend.title">Network Utilization Trend</span> <span style="color:var(--muted);font-weight:400;font-size:11px" id="trend-note" data-i18n="trend.note">（每日 05:15 自动累积）</span> <span class="k-why" title="?" data-i18n-title="why.trend" style="display:inline-block;width:14px;height:14px;border-radius:50%;background:rgba(255,255,255,.08);color:var(--muted);font-size:10px;font-weight:700;line-height:14px;text-align:center;cursor:help;vertical-align:middle">?</span></h3>
      <div id="trend" class="chart" style="height:150px"></div>
    </div>
    <div class="card" style="flex:1">
      <h3 data-i18n="dist.title">链路健康度分布</h3>
      <div id="dist" class="chart" style="height:150px"></div>
    </div>
  </div>

<div id="drawer-mask"></div>
<div id="drawer">
  <div id="drawer-head"><h3 data-i18n="drawer.title">LINK DETAILS</h3><button id="drawer-close" title="关闭" data-i18n-title="fs.close">&times;</button></div>
  <div id="drawer-body"></div>
</div>

<div id="kpi-modal-mask"></div>
<div id="kpi-modal">
  <div id="kpi-modal-head">
    <h3 id="kpi-modal-title">—</h3>
    <span id="kpi-modal-meta" data-i18n="kpiModal.metaCount"></span>
    <button id="kpi-modal-close" title="关闭" data-i18n-title="fs.close">&times;</button>
  </div>
  <div id="kpi-modal-body"></div>
</div>

<script src="./lib/echarts.min.js"></script>
<script src="./lib/leaflet/leaflet.js"></script>
<script>
/* ============ theme (TDZ-safe: declare BEFORE anything reads it) ============ */
const PALETTE = {
  dark:  { bg:'#03141d', panel:'#0a2330', text:'#e7f3f8', muted:'#8fb3c4', accent:'#19c3ff' },
  light: { bg:'#eef3f8', panel:'#ffffff', text:'#16233b', muted:'#5b7288', accent:'#0e7490' },
};
let APP_THEME = (function(){
  try { const s = localStorage.getItem('myapp-theme'); if(s==='dark'||s==='light') return s; } catch(e){}
  try { if(window.matchMedia && matchMedia('(prefers-color-scheme: light)').matches) return 'light'; } catch(e){}
  return 'dark';
})();
function curP(){ return PALETTE[APP_THEME]; }

/* ============ i18n (跟随 my_app 外壳语言: localStorage['app-locale'] + postMessage myapp-locale) ============ */
const I18N = {
  zh: {
    'app.subtitle':'微波网络拓扑', 'app.gran':'1 天',
    'topo.layout':'布局', 'topo.force':'逻辑拓扑', 'topo.geo':'地理拓扑',
    'topo.level':'级别', 'topo.lvlAll':'全部', 'topo.lvlCrit':'Critical >85%',
    'topo.lvlWarn':'Major 70-85%', 'topo.lvlWatch':'Minor 50-70%', 'topo.lvlOk':'Healthy <50%',
    'topo.label':'TX/RX 标签', 'topo.search':'搜索站点 / IP…', 'topo.refresh':'刷新',
    'topo.title':'网络拓扑', 'topo.hint':'滚轮缩放 · 拖拽平移 · 悬停查看 · 点击链路看详情',
    'topo.cNodes':'节点', 'topo.cLinks':'链路',
    'topo.geoLabel':'站点名', 'topo.access':'ACCESS 层',
    'risks.title':'Top Risk Links', 'risks.hint':'— 点击定位到拓扑',
    'risks.empty':'加载中…', 'risks.nodata':'无数据', 'risks.noMatch':'无匹配', 'risks.search':'过滤 Critical 站点…', 'risks.itemHint':'点击定位到拓扑并查看详情',
    'trend.title':'Network Utilization Trend', 'trend.note':'（每日 05:15 自动累积）',
    'trend.avg':'平均利用率', 'trend.max':'最高利用率', 'trend.crit':'紧急链路',
    'dist.title':'链路健康度分布',
    'dist.health':'Healthy <50%', 'dist.watch':'Minor 50-70%', 'dist.warn':'Major 70-85%', 'dist.crit':'Critical >85%',
    'drawer.title':'链路详情', 'drawer.capacity':'总链路容量',
    'drawer.nodeIp':'Node IP', 'drawer.interface':'接口 (PM)',
    'drawer.tx':'发送链路', 'drawer.rx':'接收链路', 'drawer.tput':'Throughput (Mbps)', 'drawer.util':'利用率',
    'drawer.trend':'Historical Trend (24H)', 'drawer.note':'当前数据粒度: 1 天（每日 05:15 自动累积）。单点为最新一次同步。',
    'drawer.cps':'端口级明细', 'drawer.noCp':'无端口级明细', 'drawer.locate':'定位到拓扑', 'drawer.close':'关闭',
    'kpi.nodes':'网络节点', 'kpi.nodesSub':'全网网元', 'kpi.links':'链路', 'kpi.linksSub':'分级链路',
    'kpi.healthy':'正常', 'kpi.watch':'次要', 'kpi.warning':'重要', 'kpi.critical':'紧急', 'kpi.max':'最高利用率',
    'kpi.lt50':'< 50%', 'kpi.r5070':'50 – 70%', 'kpi.r7085':'70 – 85%', 'kpi.gt85':'> 85%',
    'st.refreshing':'刷新中…', 'st.live':'已更新', 'st.partial':'部分更新', 'st.offline':'离线',
    'why.nodes':'链路上的网元(站 + 端口)数量',
    'why.links':'ME↔Neighbor ME 唯一链路对数（每条链路 1 个）',
    'why.linkLevel':'链路级：聚合所有端口对(PM Checkpoint)的 max(TX%,RX%)，≥阈值计 1 条',
    'why.max':'全网利用率最高的单条链路',
    'why.trend':'行级（端口对）：按天统计当天原始 PM 行里 max(TX%,RX%)≥85% 的行数；与 KPI 的链路口径不同',
    'kpiModal.metaCount':'— 行',
    'kpiModal.colNum':'#', 'kpiModal.colSite':'站点', 'kpiModal.colIP':'IP', 'kpiModal.colPeer':'对端', 'kpiModal.colPeerIP':'对端 IP',
    'kpiModal.colTX':'TX%', 'kpiModal.colRX':'RX%', 'kpiModal.colMax':'Max%', 'kpiModal.colStatus':'级别',
    'kpiModal.colDeg':'度数', 'kpiModal.colNodeMax':'Max%', 'kpiModal.colNodeStatus':'状态',
    'kpiModal.empty':'无数据', 'kpiModal.helpLink':'表内每行 = <b>链路</b>（多端口对已聚合为 max）。点击行可定位拓扑并打开链路详情抽屉。',
    'kpiModal.helpPort':'表内每行 = <b>链路</b>。点击行可定位拓扑。',
    'kpiModal.helpNodes':'表内每行 = <b>网元</b>。',
    'kpiModal.helpMax':'表内为全网利用率最高的单条链路。',
    'tt.capacity':'容量', 'tt.tx':'发送', 'tt.rx':'接收', 'tt.status':'状态',
    'tt.site':'站点', 'tt.ip':'IP', 'tt.degree':'度数', 'tt.rows':'行数据', 'tt.days':'天', 'tt.units':'条',
    'geo.hint':'地理模式 · 利比里亚 · OSM 在线地图',
    'fs.title':'全屏', 'fs.exit':'退出全屏', 'fs.max':'最大化', 'fs.restore':'还原', 'fs.close':'关闭',
  },
  en: {
    'app.subtitle':'Microwave Topology', 'app.gran':'1 Day',
    'topo.layout':'Layout', 'topo.force':'Logical', 'topo.geo':'Geographic',
    'topo.level':'Level', 'topo.lvlAll':'All', 'topo.lvlCrit':'Critical >85%',
    'topo.lvlWarn':'Major 70-85%', 'topo.lvlWatch':'Minor 50-70%', 'topo.lvlOk':'Healthy <50%',
    'topo.label':'TX/RX Label', 'topo.search':'Search site / IP…', 'topo.refresh':'Refresh',
    'topo.title':'Network Topology', 'topo.hint':'Scroll to zoom · Drag to pan · Hover to inspect · Click a link for details',
    'topo.cNodes':'nodes', 'topo.cLinks':'links',
    'topo.geoLabel':'Site labels', 'topo.access':'ACCESS tier',
    'risks.title':'Top Risk Links', 'risks.hint':'— click to locate',
    'risks.empty':'Loading…', 'risks.nodata':'No data', 'risks.noMatch':'No match', 'risks.search':'Filter critical sites…', 'risks.itemHint':'Click to locate on topology and view details',
    'trend.title':'Network Utilization Trend', 'trend.note':'（auto-accumulated daily at 05:15）',
    'trend.avg':'Avg Utilization', 'trend.max':'Max Utilization', 'trend.crit':'Critical',
    'dist.title':'Link Health Distribution',
    'dist.health':'Healthy <50%', 'dist.watch':'Minor 50-70%', 'dist.warn':'Major 70-85%', 'dist.crit':'Critical >85%',
    'drawer.title':'LINK DETAILS', 'drawer.capacity':'Total Link Capacity',
    'drawer.nodeIp':'Node IP', 'drawer.interface':'Interface (PM)',
    'drawer.tx':'TX LINK', 'drawer.rx':'RX LINK', 'drawer.tput':'Throughput (Mbps)', 'drawer.util':'UTIL',
    'drawer.trend':'Historical Trend (24H)', 'drawer.note':'Data granularity: 1 day (auto-accumulated daily at 05:15). Single point = latest sync.',
    'drawer.cps':'Interface details', 'drawer.noCp':'No interface details', 'drawer.locate':'Locate on topology', 'drawer.close':'Close',
    'kpi.nodes':'Network Nodes', 'kpi.nodesSub':'nodes', 'kpi.links':'Links', 'kpi.linksSub':'rated links',
    'kpi.healthy':'Healthy', 'kpi.watch':'Minor', 'kpi.warning':'Major', 'kpi.critical':'Critical', 'kpi.max':'Max Utilization',
    'kpi.lt50':'< 50%', 'kpi.r5070':'50 – 70%', 'kpi.r7085':'70 – 85%', 'kpi.gt85':'> 85%',
    'st.refreshing':'refreshing…', 'st.live':'live updated', 'st.partial':'partial', 'st.offline':'offline',
    'why.nodes':'Number of nodes (sites + endpoints) on links',
    'why.links':'Unique ME↔Neighbor ME link pairs (1 per link)',
    'why.linkLevel':'Link-level: aggregate max(TX%,RX%) over all PM checkpoints per link; ≥ threshold counts as 1',
    'why.max':'The single link with the highest utilization across the network',
    'why.trend':'Row-level (per port): counts rows per day where max(TX%,RX%)≥85%; KPI is link-level — different口径',
    'kpiModal.metaCount':'— rows',
    'kpiModal.colNum':'#', 'kpiModal.colSite':'Site', 'kpiModal.colIP':'IP', 'kpiModal.colPeer':'Peer', 'kpiModal.colPeerIP':'Peer IP',
    'kpiModal.colTX':'TX%', 'kpiModal.colRX':'RX%', 'kpiModal.colMax':'Max%', 'kpiModal.colStatus':'Status',
    'kpiModal.colDeg':'Degree', 'kpiModal.colNodeMax':'Max%', 'kpiModal.colNodeStatus':'Status',
    'kpiModal.empty':'No data', 'kpiModal.helpLink':'Each row = <b>one link</b> (multiple checkpoints aggregated to max). Click a row to locate on topology and open link details.',
    'kpiModal.helpPort':'Each row = <b>one link</b>. Click a row to locate.',
    'kpiModal.helpNodes':'Each row = <b>one node</b>.',
    'kpiModal.helpMax':'The single most-utilized link in the network.',
    'tt.capacity':'Capacity', 'tt.tx':'TX', 'tt.rx':'RX', 'tt.status':'Status',
    'tt.site':'Site', 'tt.ip':'IP', 'tt.degree':'Degree', 'tt.rows':'rows', 'tt.days':'days', 'tt.units':'',
    'geo.hint':'Geo mode · Liberia · OSM',
    'fs.title':'Fullscreen', 'fs.exit':'Exit fullscreen', 'fs.max':'Maximize', 'fs.restore':'Restore', 'fs.close':'Close',
  },
};
let LOCALE = 'zh';
function t(key){ return (I18N[LOCALE] && I18N[LOCALE][key]) || I18N.zh[key] || key; }

function updateStatus(){
  const st = el('status');
  if(st.dataset.state === 'ok') st.textContent = t('st.live');
  else if(st.dataset.state === 'partial') st.textContent = t('st.partial');
  else if(st.dataset.state === 'err') st.textContent = t('st.offline');
  else st.textContent = t('st.refreshing');
}

function applyLocale(locale){
  LOCALE = (locale === 'en') ? 'en' : 'zh';
  document.querySelectorAll('[data-i18n]').forEach(function(n){ n.textContent = t(n.getAttribute('data-i18n')); });
  document.querySelectorAll('[data-i18n-ph]').forEach(function(n){ n.setAttribute('placeholder', t(n.getAttribute('data-i18n-ph'))); });
  document.querySelectorAll('[data-i18n-title]').forEach(function(n){ n.setAttribute('title', t(n.getAttribute('data-i18n-title'))); });
  updateStatus();
  if(DATA){ renderRisks(); renderTopo(); renderTrend(); renderDist(); }
  if(el('drawer').classList.contains('open') && selEdge) openDrawerFor(selEdge);
  try { refreshLevelFilterUI(); syncGeoLabelBtn(); } catch(e){}  // 初始化早期 LVL_TEXT 尚在 TDZ，忽略
}
try { const l = localStorage.getItem('app-locale'); if(l === 'en' || l === 'zh') LOCALE = l; } catch(e){}

/* ============ global state ============ */
let DATA = null;
let chart = null, trendChart = null, distChart = null;
let layoutMode = 'geo';         // 默认显示物理拓扑（force | geo）
let levelFilter = [];          // 多选：状态数组，空数组 = 全部
let showLabel = false;
let geoShowLabels = false;     // 物理拓扑站点名显示开关（默认关）
let collapseAccess = false;    // 逻辑拓扑折叠 ACCESS 层（默认不折叠）
let selEdge = null;            // 当前选中的边
let selNodeIds = [];           // 当前选中节点（展开卡片）
let lastLayout = null;         // 最近一次分层布局（供 resetView 居中）

/* ============ 分层拓扑布局（替代 force） ============ */
const TIER_ORDER = { CORE:0, HUB:1, SITE:2, ACCESS:3 };
function nodeTier(d){ const x = d||0; return x>=8 ? 'CORE' : x>=4 ? 'HUB' : x>=2 ? 'SITE' : 'ACCESS'; }
// 平行/重复链路按索引分配不同弧度，形成扇形避让
const EDGE_CURVES = [0.22, 0.13, 0.04, -0.05, -0.14, -0.23];
function neutralFill(){ return APP_THEME==='light' ? '#cdddea' : '#15384f'; }
function computeLayout(){
  if(!DATA) return { pos:{}, tier:{}, centerX:0, xRange:1 };
  const deg = {}; DATA.nodes.forEach(n => deg[n.id] = n.degree||0);
  const tier = {}; DATA.nodes.forEach(n => tier[n.id] = nodeTier(n.degree));
  const cols = ['CORE','HUB','SITE','ACCESS'];
  const byTier = { CORE:[], HUB:[], SITE:[], ACCESS:[] };
  DATA.nodes.forEach(n => byTier[tier[n.id]].push(n.id));
  cols.forEach(c => byTier[c].sort((a,b)=> (deg[b]-deg[a])));
  const adj = {}; DATA.nodes.forEach(n => adj[n.id] = []);
  DATA.edges.forEach(e => { if(adj[e.source] && adj[e.target]){ adj[e.source].push(e.target); adj[e.target].push(e.source); } });
  // barycenter 排序：每层按上一层/下一层邻居的纵向位置排序，减少交叉（正向+反向各 3 轮）
  for(let pass=0; pass<3; pass++){
    for(let ci=1; ci<cols.length; ci++){
      const cur = byTier[cols[ci]], prev = byTier[cols[ci-1]];
      const prevIdx = {}; prev.forEach((id,i)=> prevIdx[id]=i);
      const keyf = id => {
        const ns = adj[id].filter(x => tier[x]===cols[ci-1]);
        if(!ns.length) return prev.length/2;
        let s=0; ns.forEach(x => s += (prevIdx[x]!=null ? prevIdx[x] : prev.length/2)); return s/ns.length;
      };
      cur.sort((a,b)=> keyf(a)-keyf(b));
    }
    for(let ci=cols.length-2; ci>=0; ci--){
      const cur = byTier[cols[ci]], nxt = byTier[cols[ci+1]];
      const nxtIdx = {}; nxt.forEach((id,i)=> nxtIdx[id]=i);
      const keyf = id => {
        const ns = adj[id].filter(x => tier[x]===cols[ci+1]);
        if(!ns.length) return nxt.length/2;
        let s=0; ns.forEach(x => s += (nxtIdx[x]!=null ? nxtIdx[x] : nxt.length/2)); return s/ns.length;
      };
      cur.sort((a,b)=> keyf(a)-keyf(b));
    }
  }
  // 二维网格平铺：密集层（>12 节点）改为按子列分行，腾出横向空间
  // （否则 525 个 HUB 全堆在一列会撑成 28kpx 高，画布被压扁成一根线）
  const TIER_GAP = 320;          // 相邻层级之间的最小间隙
  const ROW_GAP = 48;            // 1D 列内节点间距
  const SUB_GAP = 42;            // 2D 网格内节点间距（需 > max symbolSize 保证不重叠）
  const GRID_W_MAX = 30;         // 网格最大宽度
  const ONE_D_THRESHOLD = 12;    // 节点数 ≤ 此值用 1D 列，否则用 2D 网格
  const pos = {};
  const tierDim = {};
  // 先算每层尺寸
  cols.forEach(c => {
    const n = byTier[c].length;
    if (n === 0) { tierDim[c] = { halfW:0, halfH:0, mode:'1d', gridCols:0, gridRows:0 }; return; }
    if (n <= ONE_D_THRESHOLD) {
      tierDim[c] = { halfW:0, halfH: (n-1)*ROW_GAP/2, mode:'1d', gridCols:0, gridRows:0 };
    } else {
      // 网格宽度：不超过 GRID_W_MAX，按 sqrt(n)*1.5 自适应（避免窄长条）
      const gc = Math.min(GRID_W_MAX, Math.max(10, Math.ceil(Math.sqrt(n) * 1.5)));
      const gr = Math.ceil(n / gc);
      tierDim[c] = { halfW:(gc-1)*SUB_GAP/2, halfH:(gr-1)*SUB_GAP/2, mode:'2d', gridCols:gc, gridRows:gr };
    }
  });
  // 按顺序左→右铺设
  let curRight = 0;
  cols.forEach((c) => {
    const arr = byTier[c];
    const n = arr.length;
    if (n === 0) return;
    const dim = tierDim[c];
    const tierCenterX = curRight + dim.halfW;
    if (dim.mode === '1d') {
      arr.forEach((id, i) => {
        pos[id] = { x: tierCenterX, y: (i - (n-1)/2) * ROW_GAP, tier: c };
      });
    } else {
      arr.forEach((id, i) => {
        const row = Math.floor(i / dim.gridCols);
        const col = i % dim.gridCols;
        pos[id] = {
          x: tierCenterX - dim.halfW + col * SUB_GAP,
          y: -dim.halfH + row * SUB_GAP,
          tier: c
        };
      });
    }
    curRight = tierCenterX + dim.halfW + TIER_GAP;
  });
  const xRange = curRight - TIER_GAP;
  return { pos, tier, centerX: xRange/2, xRange: xRange || 1 };
}
let REFRESHING = false;
let geoJson = null;
applyLocale(LOCALE);
window.addEventListener('message', function(e){
  if(e.data && e.data.__type === 'myapp-locale') applyLocale(e.data.locale);
});

/* ============ level colors ============ */
const LVL_COLOR = { healthy:'#27d39a', watch:'#ffd43b', warning:'#ff922b', critical:'#ff6b6b', unknown:'#64748b' };
const LVL_TEXT = { healthy:'Healthy', watch:'Minor', warning:'Major', critical:'Critical', unknown:'Unknown' };



/* ============ echarts themes ============ */
function regThemes(){
  const darkAxis = { color:'#8fb3c4', fontSize:11 };
  const lightAxis = { color:'#5b7288', fontSize:11 };
  echarts.registerTheme('amDark', {
    color:['#19c3ff','#27d39a','#ffd43b','#ff922b','#ff6b6b','#7986cb','#b197fc'],
    backgroundColor:'transparent', textStyle:{ color:'#e7f3f8' },
    legend:{ textStyle:{ color:'#e7f3f8' } },
    tooltip:{ backgroundColor:'rgba(3,20,29,0.95)', borderColor:'rgba(25,195,255,0.25)', textStyle:{color:'#e7f3f8'} },
    categoryAxis:{ axisLine:{lineStyle:{color:'#16415a'}}, axisLabel:darkAxis, splitLine:{lineStyle:{color:'rgba(255,255,255,0.06)'}} },
    valueAxis:{ axisLine:{lineStyle:{color:'#16415a'}}, axisLabel:darkAxis, splitLine:{lineStyle:{color:'rgba(255,255,255,0.06)'}} },
  });
  echarts.registerTheme('amLight', {
    color:['#0e7490','#0f9d6b','#b45309','#c2410c','#d92d20','#6366f1','#15803d'],
    backgroundColor:'transparent', textStyle:{ color:'#16233b' },
    legend:{ textStyle:{ color:'#16233b' } },
    tooltip:{ backgroundColor:'rgba(255,255,255,0.97)', borderColor:'rgba(13,148,136,0.35)', textStyle:{color:'#16233b'} },
    categoryAxis:{ axisLine:{lineStyle:{color:'#d3e0ec'}}, axisLabel:lightAxis, splitLine:{lineStyle:{color:'rgba(22,35,59,0.10)'}} },
    valueAxis:{ axisLine:{lineStyle:{color:'#d3e0ec'}}, axisLabel:lightAxis, splitLine:{lineStyle:{color:'rgba(22,35,59,0.10)'}} },
  });
}
regThemes();

function applyTheme(mode){
  APP_THEME = (mode === 'light') ? 'light' : 'dark';
  try { document.documentElement.dataset.theme = APP_THEME; } catch(e){}
  applyMapTheme();
  renderTopo(); renderTrend(); renderDist();
}
// 地图底图跟随主题：深色 → OSM 瓦片暗色滤镜；浅色 → 浅底
function applyMapTheme(){
  const m = el('topo-leaflet');
  if(!m) return;
  const dark = APP_THEME === 'dark';
  m.classList.toggle('dark-map', dark);
  m.classList.toggle('light-map', !dark);
}
window.addEventListener('message', function(e){
  if(e.data && e.data.__type === 'myapp-theme') applyTheme(e.data.mode);
});
try {
  if(window.matchMedia){
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function(e){
      try { if(!localStorage.getItem('myapp-theme')) applyTheme(e.matches ? 'dark' : 'light'); } catch(err){}
    });
  }
} catch(e){}

/* ============ helpers ============ */
function el(id){ return document.getElementById(id); }
function fmtMbps(v){ if(v==null) return '—'; v=+v; if(!isFinite(v)) return '—'; return (v>=1000 ? (v/1000).toFixed(2)+' Gbps' : v.toFixed(1)+' Mbps'); }
function fmtPct(v){ if(v==null) return '—'; v=+v; if(!isFinite(v)) return '—'; return v.toFixed(1)+'%'; }
function shortName(full){ return (full||'').replace(/\(\d+\.\d+\.\d+\.\d+\)$/,''); }

/* ============ data load ============ */
async function loadData(force){
  if(REFRESHING) return;
  REFRESHING = true;
  const st = el('status');
  st.className = 'status-pill'; st.dataset.state = 'refreshing'; updateStatus();
  try{
    const url = '/api/mw-ume/topology?top_n=10' + (force ? '&refresh=1' : '');
    const r = await fetch(url);
    if(!r.ok) throw new Error('HTTP '+r.status);
    DATA = await r.json();
    st.className = 'status-pill ok'; st.dataset.state = 'ok'; updateStatus();
    renderAll();
  }catch(e){
    st.className = 'status-pill err';
    st.dataset.state = DATA ? 'partial' : 'err';
    st.title = e.message;
    updateStatus();
    console.error(e);
  }finally{
    REFRESHING = false;
  }
}

/* ============ render ============ */
function renderAll(){
  if(!DATA) return;
  el('meta-date').textContent = (DATA.trends && DATA.trends.length) ? DATA.trends[0].date : '—';
  const k = DATA.kpis;
  el('k-nodes').textContent = k.nodes;
  el('k-nodes-sub').textContent = DATA.meta.counts.rows + ' ' + t('tt.rows') + ' · ' + DATA.meta.counts.begin_times + ' ' + t('tt.days');
  el('k-links').textContent = k.links;
  el('k-links-sub').textContent = (k.healthy+k.watch+k.warning+k.critical) + ' ' + t('kpi.linksSub');
  el('k-healthy').textContent = k.healthy;
  el('k-watch').textContent = k.watch;
  el('k-warning').textContent = k.warning;
  el('k-critical').textContent = k.critical;
  el('k-max').textContent = (k.max_utilization==null ? '—' : k.max_utilization.toFixed(1)+'%');
  el('k-max-sub').textContent = k.max_util_link ? (k.max_util_link.source_site||shortName(k.max_util_link.source)) + ' ↔ ' + (k.max_util_link.target_site||shortName(k.max_util_link.target)) : '—';
  renderRisks();
  renderTopo();
  renderTrend();
  renderDist();
}

/* ============ topology chart ============ */
function nodeSize(d){ const t = nodeTier(d); return t==='CORE' ? 26 : t==='HUB' ? 19 : t==='SITE' ? 13 : 10; }
// 线宽统一：不再用 Capacity 决定粗细，避免“粗线=大流量”的误导
function edgeWidth(){ return 2; }

function buildGraphData(){
  if(!DATA) return {nodes:[], links:[]};
  const L = computeLayout();
  lastLayout = L;
  const q = (el('inp-search').value||'').trim().toLowerCase();
  // 搜索：命中站点 + 其上下游 2 跳邻居（连同相关链路一起展示）
  let hitIds = null, keepIds = null;
  if(q){
    hitIds = new Set();
    DATA.nodes.forEach(n => {
      if((n.name||'').toLowerCase().includes(q) || (n.site||'').toLowerCase().includes(q) || (n.ip||'').toLowerCase().includes(q)) hitIds.add(n.id);
    });
    keepIds = new Set(hitIds);
    DATA.edges.forEach(e => { if(hitIds.has(e.source)) keepIds.add(e.target); if(hitIds.has(e.target)) keepIds.add(e.source); });  // 1 跳
    DATA.edges.forEach(e => { if(keepIds.has(e.source)) keepIds.add(e.target); if(keepIds.has(e.target)) keepIds.add(e.source); });  // 2 跳
  }
  const nodes = [];
  DATA.nodes.forEach(n => {
    if(keepIds && !keepIds.has(n.id)) return;
    const lp = L.pos[n.id] || { x:0, y:0, tier:'ACCESS' };
    const isSel = selNodeIds.indexOf(n.id) >= 0;
    const hit = q && hitIds.has(n.id);
    // 默认折叠 ACCESS 层：仅保留命中/选中/搜索邻域内的 ACCESS 节点
    if(collapseAccess && lp.tier==='ACCESS' && !hit && !isSel && !(keepIds && keepIds.has(n.id))) return;
    let label;
    if(isSel){
      // 选中站点 → 展开卡片
      label = {
        show:true, position:'right', distance:6,
        formatter: function(){
          return [ (n.site||shortName(n.id)), '────────────',
                   'IP      '+(n.ip||'—'), 'Links   '+(n.degree||0),
                   'MaxUtil '+(n.max_util==null?'—':n.max_util.toFixed(1)+'%'),
                   'Status  '+(LVL_TEXT[n.status]||n.status) ].join('\n');
        },
        backgroundColor: curP().panel, borderColor: LVL_COLOR[n.status]||LVL_COLOR.unknown, borderWidth:1,
        padding:[6,8], borderRadius:6, lineHeight:14, fontSize:11, color: curP().text, fontWeight:'bold',
      };
    } else if(lp.tier==='CORE' || lp.tier==='HUB' || hit){
      // 高层级站点 / 搜索命中 → 显示名称（解决“站点不像站点”）
      label = { show:true, position:'bottom', distance:4, formatter: (n.site||shortName(n.id)),
                fontSize:11, color: curP().text, backgroundColor:'transparent' };
    } else {
      label = { show:false };
    }
    nodes.push({
      id: n.id, name: shortName(n.id),
      x: lp.x, y: lp.y,
      symbolSize: nodeSize(n.degree),
      // 站点：中性底色 + 状态外圈 Halo（颜色不再绑定链路颜色）
      itemStyle: { color: neutralFill(), borderColor: LVL_COLOR[n.status]||LVL_COLOR.unknown, borderWidth:2,
                   shadowColor: LVL_COLOR[n.status]||LVL_COLOR.unknown,
                   shadowBlur: n.status==='critical' ? 16 : n.status==='warning' ? 8 : n.status==='watch' ? 3 : 0 },
      label: label,
      _site: n.site, _ip: n.ip, _deg: n.degree, _status: n.status, _tier: lp.tier,
      _lat: n.lat, _lon: n.lon,
      value: (n.lon != null && n.lat != null) ? [n.lon, n.lat] : undefined,
    });
  });
  // 链路：统一线宽；颜色=利用率(status)；平行链路扇形弧度避让；默认隐藏 TX/RX 数字
  const pairCount = {};
  let links = DATA.edges.map(e => {
    const a=String(e.source), b=String(e.target);
    const key = a<b ? a+'|'+b : b+'|'+a;
    const idx = (pairCount[key] = (pairCount[key]||0)); pairCount[key]++;
    const curv = EDGE_CURVES[idx % EDGE_CURVES.length];
    const sel = selEdge && ((e.source===selEdge.source && e.target===selEdge.target) ||
                            (e.source===selEdge.target && e.target===selEdge.source));
    const label = sel ? { show:true, position:'middle', fontSize:10, color: curP().text,
                          backgroundColor: curP().panel, padding:[2,5], borderRadius:3,
                          formatter: 'TX '+(e.tx_util==null?'—':e.tx_util.toFixed(0)+'%') + ' / RX ' + (e.rx_util==null?'—':e.rx_util.toFixed(0)+'%') }
                        : { show:false };
    return {
      source: e.source, target: e.target,
      lineStyle: { color: LVL_COLOR[e.status]||LVL_COLOR.unknown, width: edgeWidth(e),
                   opacity: (e.status==='critical'||e.status==='warning') ? 0.95 : 0.55,
                   curveness: curv,
                   shadowBlur: e.status==='critical' ? 8 : 0,
                   shadowColor: LVL_COLOR[e.status]||LVL_COLOR.unknown },
      label: label,
      _tx: e.tx_util, _rx: e.rx_util, _cap: e.capacity, _status: e.status,
      _max: e.max_util, _tx_t: e.tx_throughput, _rx_t: e.rx_throughput,
    };
  });
  // 折叠 ACCESS 层：只保留两端都可见的链路
  if(collapseAccess){
    const vis = new Set(nodes.map(n => n.id));
    links = links.filter(l => vis.has(l.source) && vis.has(l.target));
  }
  // 搜索：只保留邻域内的链路
  if(keepIds){
    links = links.filter(l => keepIds.has(l.source) && keepIds.has(l.target));
  }
  // level filter（多选：空数组 = 全部）
  if(levelFilter.length){
    const st = new Set(levelFilter);
    links = links.filter(l => st.has(l._status));
    const keep = new Set();
    links.forEach(l => { keep.add(l.source); keep.add(l.target); });
    const nn = nodes.filter(n => keep.has(n.id));
    return { nodes: nn, links };
  }
  return { nodes, links };
}

function renderTopo(){
  if(!DATA) return;
  if(layoutMode === 'geo'){
    showLeaflet();
    renderTopoLeaflet();
  } else {
    hideLeaflet();
    renderTopoEcharts();
  }
}

/* ============ Leaflet 地理模式（OSM 在线瓦片 + 弧线链路 + 流量动画） ============ */
let leafMap = null, nodeLayer = null, linkLayer = null, flowLayer = null;
let geoNodeMarkers = [];
function showLeaflet(){
  el('topo').style.display = 'none';
  el('topo-leaflet').style.display = 'block';
  ensureLeafletMap();
  setTimeout(function(){ try{ leafMap.invalidateSize(); }catch(e){} }, 40);
}
function hideLeaflet(){
  el('topo-leaflet').style.display = 'none';
  el('topo').style.display = 'block';
  if(chart) setTimeout(function(){ try{ chart.resize(); }catch(e){} }, 40);
}
function ensureLeafletMap(){
  if(leafMap) return;
  leafMap = L.map('topo-leaflet', { zoomControl:true, attributionControl:true }).setView([-9.7, 6.6], 7);
  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    maxZoom: 19, attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
  }).addTo(leafMap);
  linkLayer = L.layerGroup().addTo(leafMap);
  flowLayer = L.layerGroup().addTo(leafMap);
  nodeLayer = L.layerGroup().addTo(leafMap);
  applyMapTheme();
  leafMap.on('zoomend', onGeoViewChange);
  leafMap.on('moveend', onGeoViewChange);
}
// 视图变化（缩放/平移）→ 重新计算站点标签分级与聚合（链路动画为 CSS，自动保留）
function onGeoViewChange(){
  if(leafMap) renderGeoNodes();
}
// 弧线采样：站点间生成带弯曲的折线；bend 控制弯曲方向与强度（平行链路分流）
function arcPoints(sLat, sLon, tLat, tLon, bend){
  const dx = tLon - sLon, dy = tLat - sLat;
  const len = Math.hypot(dx, dy) || 1e-6;
  const px = -dy / len, py = dx / len;          // 垂直单位向量
  const midLat = (sLat + tLat) / 2, midLon = (sLon + tLon) / 2;
  const off = bend * len;
  const cLat = midLat + py * off, cLon = midLon + px * off;
  const N = 24, pts = [];
  for(let i = 0; i <= N; i++){
    const u = 1 - i / N, t = i / N;
    pts.push([ u*u*sLat + 2*u*t*cLat + t*t*tLat, u*u*sLon + 2*u*t*cLon + t*t*tLon ]);
  }
  return pts;
}
// 缩放级别 → 站点标签粒度：0 无 / 1 名称 / 2 名称+IP
function geoLabelLevel(z){ return z < 8 ? 0 : (z < 11 ? 1 : 2); }
function nodeIconHtml(n, lvl){
  const color = LVL_COLOR[n.status] || LVL_COLOR.unknown;
  // 站点名显示由按钮开关控制（默认关闭，减少噪声）
  const ip = (geoShowLabels && n.ip && lvl === 2) ? ('<span class="geo-ip">' + n.ip + '</span>') : '';
  const name = (geoShowLabels && lvl >= 1) ? ('<span class="geo-name">' + (n.site || n.name) + '</span>') : '';
  return '<span class="geo-node"><span class="geo-dot" style="background:' + color +
         ';box-shadow:0 0 6px ' + color + '"></span>' + name + ip + '</span>';
}
function clusterIconHtml(k){ return '<span class="geo-cluster">◉ ' + k + '</span>'; }
function addGeoNode(n, lvl){
  const m = L.marker([n.lat, n.lon], {
    icon: L.divIcon({ className:'geo-marker', html: nodeIconHtml(n, lvl), iconSize:[9,9], iconAnchor:[4.5,4.5] }),
    interactive:true
  });
  m._node = n;
  m.on('click', function(){
    linkLayer.eachLayer(pl => {
      const ed = pl._edge;
      if(ed && (ed.source === n.id || ed.target === n.id)){
        pl.setStyle({ weight:6, opacity:1, color:'#19c3ff' });
      } else if(ed){
        pl.setStyle({ weight:2, opacity:.45, color: LVL_COLOR[ed.status] || LVL_COLOR.unknown });
      }
    });
    flowLayer.eachLayer(pl => {
      const ed = pl._edge;
      if(ed) pl.setStyle({ opacity: (ed.source === n.id || ed.target === n.id) ? 1 : .22 });
    });
  });
  nodeLayer.addLayer(m);
  geoNodeMarkers.push({ node:n, marker:m });
}
function renderGeoNodes(){
  if(!leafMap) return;
  const src = (window.__geoNodes || []);
  nodeLayer.clearLayers(); geoNodeMarkers = [];
  const lvl = geoLabelLevel(leafMap.getZoom());
  if(lvl === 0){
    // 低缩放：按屏幕网格聚合相邻站点，避免点重叠
    const cell = 48, buckets = {};
    src.forEach(n => {
      const p = leafMap.latLngToContainerPoint([n.lat, n.lon]);
      const key = Math.floor(p.x / cell) + '_' + Math.floor(p.y / cell);
      (buckets[key] = buckets[key] || []).push(n);
    });
    Object.keys(buckets).forEach(k => {
      const arr = buckets[k];
      if(arr.length === 1){ addGeoNode(arr[0], lvl); return; }
      const lat = arr.reduce((s, n) => s + n.lat, 0) / arr.length;
      const lon = arr.reduce((s, n) => s + n.lon, 0) / arr.length;
      const cm = L.marker([lat, lon], {
        icon: L.divIcon({ className:'geo-marker', html: clusterIconHtml(arr.length), iconSize:[60,20], iconAnchor:[30,10] }),
        interactive:true
      });
      cm.on('click', function(){ leafMap.setView([lat, lon], Math.min(18, leafMap.getZoom() + 3)); });
      nodeLayer.addLayer(cm);
    });
  } else {
    src.forEach(n => addGeoNode(n, lvl));
  }
}
function renderTopoLeaflet(){
  if(!DATA || !leafMap) return;
  const nodeById = {};
  DATA.nodes.forEach(n => nodeById[n.id] = n);
  let nodes = DATA.nodes.filter(n => n.lat != null && n.lon != null);
  let links = DATA.edges.filter(e => {
    const s = nodeById[e.source], t = nodeById[e.target];
    return s && s.lat != null && t && t.lat != null;
  });
  if(levelFilter.length){
    const st = new Set(levelFilter);
    links = links.filter(l => st.has(l.status));
    const keep = new Set();
    links.forEach(l => { keep.add(l.source); keep.add(l.target); });
    nodes = nodes.filter(n => keep.has(n.id));
  }
  const q = (el('inp-search').value||'').trim().toLowerCase();
  if(q){
    // 搜索：命中站点 + 上下游 2 跳邻居，保留邻域内全部链路
    const hit = new Set();
    DATA.nodes.forEach(n => {
      if((n.name||'').toLowerCase().includes(q) || (n.site||'').toLowerCase().includes(q) || (n.ip||'').toLowerCase().includes(q)) hit.add(n.id);
    });
    const keep = new Set(hit);
    links.forEach(l => { if(hit.has(l.source)) keep.add(l.target); if(hit.has(l.target)) keep.add(l.source); });  // 1 跳
    links.forEach(l => { if(keep.has(l.source)) keep.add(l.target); if(keep.has(l.target)) keep.add(l.source); });  // 2 跳
    nodes = nodes.filter(n => keep.has(n.id));
    links = links.filter(l => keep.has(l.source) && keep.has(l.target));
    setTimeout(function(){
      try{
        const gn = nodes.filter(n => n.lat != null && n.lon != null);
        if(gn.length) leafMap.fitBounds(L.latLngBounds(gn.map(n => [n.lat, n.lon])), { padding:[60,60] });
      }catch(e){ console.warn('geoFit', e); }
    }, 120);
  }
  window.__geoNodes = nodes;
  el('topo-count').textContent = nodes.length + ' ' + t('topo.cNodes') + ' / ' + links.length + ' ' + t('topo.cLinks');

  // 平行链路分组 → 弧度分流（避免重叠直线）
  const pairMap = {};
  links.forEach(e => {
    const key = [e.source, e.target].sort().join('|');
    (pairMap[key] = pairMap[key] || []).push(e);
  });
  const BENDS = [0, 0.16, -0.16, 0.30, -0.30, 0.44, -0.44];
  const bendOf = {};
  Object.keys(pairMap).forEach(k => {
    pairMap[k].forEach((e, i) => { bendOf[e.source + '>' + e.target] = BENDS[i % BENDS.length]; });
  });

  linkLayer.clearLayers(); flowLayer.clearLayers();
  links.forEach(e => {
    const s = nodeById[e.source], t = nodeById[e.target];
    const bend = bendOf[e.source + '>' + e.target] || 0;
    const pts = arcPoints(s.lat, s.lon, t.lat, t.lon, bend);
    const color = LVL_COLOR[e.status] || LVL_COLOR.unknown;
    // 基础弧线
    const base = L.polyline(pts, { color: color, weight: 2, opacity: .55, lineCap: 'round' });
    base._edge = e;
    base.bindTooltip((s.site || shortName(e.source)) + ' → ' + (t.site || shortName(e.target)) +
      '<br/>TX ' + fmtPct(e.tx_util) + ' / RX ' + fmtPct(e.rx_util), {sticky:true});
    base.on('click', function(){ selectEdge({ source:e.source, target:e.target, _status:e.status, _tx:e.tx_util, _rx:e.rx_util, _max:e.max_util, _cap:e.capacity }, true); });
    linkLayer.addLayer(base);
    // 关键/警告链路：发光底衬
    if(e.status === 'critical' || e.status === 'warning'){
      const glow = L.polyline(pts, { color: color, weight: 7, opacity: .18, lineCap:'round', interactive:false });
      glow._edge = e;
      linkLayer.addLayer(glow);
    }
    // 流量动画叠层（CSS dash 流动，方向 s→t；速度随利用率提升）
    const flow = L.polyline(pts, { color: color, weight: 2.6, opacity: .95, className:'flow-line', interactive:false });
    flow._edge = e;
    flowLayer.addLayer(flow);
    const dur = (1.2 + (100 - Math.min(100, e.max_util || 0)) / 100 * 4).toFixed(2);
    try { if(flow._path) flow._path.style.animationDuration = dur + 's'; } catch(_){}
    setTimeout(function(){ try { if(flow._path) flow._path.style.animationDuration = dur + 's'; } catch(__){} }, 0);
  });
  renderGeoNodes();
  el('topo-hint').textContent = t('geo.hint');
}

/* ============ ECharts 逻辑拓扑（force 模式） ============ */
function renderTopoEcharts(){
  if(!DATA) return;
  if(!chart) chart = echarts.init(el('topo'), APP_THEME==='dark'?'amDark':'amLight', {renderer:'canvas'});
  const g = buildGraphData();
  const nodes = g.nodes, links = g.links;
  // 搜索过滤已在 buildGraphData 完成（命中站点 + 上下游邻居）
  const q = (el('inp-search').value||'').trim().toLowerCase();
  el('topo-count').textContent = nodes.length + ' ' + t('topo.cNodes') + ' / ' + links.length + ' ' + t('topo.cLinks');
  const series = {
    type:'graph',
    layout: 'none',            // 分层拓扑（坐标由 computeLayout 计算），不再用 force
    roam: true,
    draggable: true,
    focusNodeAdjacency: true,  // 悬停聚焦邻接，自动淡化无关节点/链路
    edgeSymbol: ['none','none'],
    edgeSymbolSize: [0, 0],
    label: { show:false },
    lineStyle: { curveness: 0 },
    emphasis: { focus: 'adjacency', lineStyle: { width: 3, opacity: 1 } },
    data: nodes,
    links: links,
  };
  const option = {
    tooltip: {
      trigger: 'item',
      backgroundColor: 'rgba(3,20,29,0.92)', borderColor: 'rgba(25,195,255,0.3)',
      textStyle: { color: curP().text },
      formatter: function(p){
        if(p.dataType === 'edge'){
          const d = p.data;
          return '<b>' + shortName(d.source) + ' → ' + shortName(d.target) + '</b><br/>' +
            t('tt.capacity') + ': ' + fmtMbps(d._cap) + '<br/>' +
            'TX: ' + fmtMbps(d._tx_t) + ' / ' + fmtPct(d._tx) + '<br/>' +
            'RX: ' + fmtMbps(d._rx_t) + ' / ' + fmtPct(d._rx) + '<br/>' +
            t('tt.status') + ': <b style="color:' + LVL_COLOR[d._status] + '">' + LVL_TEXT[d._status] + '</b>';
        }
        const d = p.data;
        return '<b>' + d.name + '</b><br/>' + t('tt.site') + ': ' + (d._site||'—') + '<br/>' +
          t('tt.ip') + ': ' + (d._ip||'—') + '<br/>' + t('tt.degree') + ': ' + d._deg;
      }
    },
    series: [series],
  };
  chart.setOption(option, true);
  if(q){
    setTimeout(function(){ try { autoCenter(nodes); } catch(e){ console.warn('autoCenter', e); } }, 120);
  }
  chart.off('click');
  chart.on('click', function(p){
    if(p.dataType === 'edge'){ selectEdge(p.data, true); }
    else if(p.dataType === 'node'){
      // 点击站点 → 展开卡片
      selNodeIds = [p.data.id]; renderRisks(); renderTopoEcharts();
    }
  });
}

/* ============ Top risks（全部 Critical + 模糊搜索） ============ */
function riskItems(){
  if(!DATA) return [];
  const siteOf = {}; DATA.nodes.forEach(n => siteOf[n.id] = n.site);
  return DATA.edges
    .filter(e => e.status === 'critical')
    .map(r => ({ source:r.source, target:r.target, status:r.status, tx_util:r.tx_util, rx_util:r.rx_util,
                 max_util:r.max_util, capacity:r.capacity, source_site:siteOf[r.source], target_site:siteOf[r.target] }))
    .sort((a,b)=>(b.max_util||0)-(a.max_util||0));
}
function renderRisks(){
  const list = el('risk-list');
  if(!DATA){
    list.innerHTML = '<div class="empty">' + t('risks.empty') + '</div>'; return;
  }
  // 不再受 top_n 限制：列出全部 Critical 链路（按 max_util 降序）
  const all = riskItems();
  const q = (el('risk-search').value||'').trim().toLowerCase();
  const items = q ? all.filter(r => ((r.source_site||'') + ' ' + (r.target_site||'') + ' ' + r.source + ' ' + r.target).toLowerCase().includes(q)) : all;
  const cnt = el('risk-count');
  if(cnt) cnt.textContent = '(' + items.length + ' / ' + all.length + ')';
  if(!items.length){
    list.innerHTML = '<div class="empty">' + (q ? t('risks.noMatch') : t('risks.nodata')) + '</div>'; return;
  }
  list.innerHTML = '';
  items.forEach(r => {
    const d = document.createElement('div');
    d.className = 'risk-item' + (selEdge && selEdge.source===r.source && selEdge.target===r.target ? ' sel' : '');
    d.innerHTML =
      '<span class="dot dot-' + r.status + '"></span>' +
      '<div class="r-main"><div class="r-name">' + (r.source_site||shortName(r.source)) + ' → ' + (r.target_site||shortName(r.target)) + '</div>' +
      '<div class="r-sub">' + r.source + ' ↔ ' + r.target + '</div></div>' +
      '<div class="r-pct" style="color:' + LVL_COLOR[r.status] + '">' + fmtPct(r.max_util) + '</div>' +
      '<div class="r-txrx">TX ' + fmtPct(r.tx_util) + '<br/>RX ' + fmtPct(r.rx_util) + '</div>';
    d.title = t('risks.itemHint');
    d.onclick = function(){
      selectEdge({ source: r.source, target: r.target, _status: r.status,
                   _tx: r.tx_util, _rx: r.rx_util, _max: r.max_util, _cap: r.capacity }, true);
    };
    list.appendChild(d);
  });
}

/* ============ select / locate edge ============ */
function findEdgeData(src, tgt){
  if(!DATA) return null;
  return DATA.edges.find(e =>
    (e.source===src && e.target===tgt) || (e.source===tgt && e.target===src)) || null;
}
function findNode(id){ return DATA ? DATA.nodes.find(n => n.id === id) : null; }

function selectEdge(edge, openDrawer){
  const full = findEdgeData(edge.source, edge.target);
  if(!full) return;
  selEdge = full;
  renderRisks();
  // 高亮 + 定位
  if(layoutMode === 'geo' && leafMap){
    linkLayer.eachLayer(pl => {
      const ed = pl._edge;
      if(ed && ((ed.source===full.source && ed.target===full.target) || (ed.source===full.target && ed.target===full.source))){
        pl.setStyle({weight:6, opacity:1, color:'#19c3ff'});
      } else {
        pl.setStyle({weight:edgeWidth(ed), opacity:.8, color:LVL_COLOR[ed.status]||LVL_COLOR.unknown});
      }
    });
    const src = findNode(full.source), tgt = findNode(full.target);
    if(src && tgt && src.lon != null && tgt.lon != null){
      leafMap.setView([(src.lat+tgt.lat)/2, (src.lon+tgt.lon)/2], Math.max(leafMap.getZoom(), 8));
    }
  } else if(chart){
    try{
      // 选中链路 → 两端站点展开卡片
      selNodeIds = [full.source, full.target];
      renderTopoEcharts();
      setTimeout(function(){
        const opt = chart.getOption();
        const sd = opt.series && opt.series[0] ? opt.series[0].data : null;
        if(sd){
          const a = sd.find(n => n.id === full.source), b = sd.find(n => n.id === full.target);
          if(a && b && typeof a.x === 'number' && typeof b.x === 'number'){
            chart.setOption({ series: [{ center: [(a.x + b.x) / 2, (a.y + b.y) / 2], zoom: 2.2 }] });
          }
        }
      }, 30);
    }catch(e){ console.warn('locate', e); }
  }
  if(openDrawer) openDrawerFor(full);
}

/* ============ drawer ============ */
const THRESHOLDS_T = { watch: 50, warning: 70, critical: 85 };
let drawerTrend = null;
function utilClass(u){
  if(u == null) return 'u-ok'; u=+u; if(!isFinite(u)) return 'u-ok';
  if(u >= THRESHOLDS_T.critical) return 'u-crit';
  if(u >= THRESHOLDS_T.warning) return 'u-warn';
  if(u >= THRESHOLDS_T.watch) return 'u-watch';
  return 'u-ok';
}

function openDrawerFor(e){
  const body = el('drawer-body');
  const srcN = findNode(e.source), tgtN = findNode(e.target);
  const srcDisp = shortName(e.source);
  const tgtDisp = shortName(e.target);
  const srcIp = (srcN && srcN._ip) || '—';
  const tgtIp = (tgtN && tgtN._ip) || '—';
  // 端口对：取首个 checkpoint（聚合口径）；如有多个则下方列出明细
  const cps = e.checkpoints || [];
  const head = cps[0] || {};
  const srcCp = head.cp || '—';
  const tgtCp = head.ncp || '—';

  body.innerHTML =
    '<div><span class="d-pill" style="background:' + LVL_COLOR[e.status] + '22;color:' + LVL_COLOR[e.status] + '"><span class="dot" style="background:' + LVL_COLOR[e.status] + '"></span>' + LVL_TEXT[e.status].toUpperCase() + '</span></div>' +
    '<div class="d-cap">' + (e.capacity==null ? '—' : (e.capacity>=1000 ? (e.capacity/1000).toFixed(2) : e.capacity.toFixed(2))) + '<span class="u">' + (e.capacity>=1000?'Gbps':'Mbps') + '</span></div>' +
    '<div class="d-cap-label">' + t('drawer.capacity') + '</div>' +

    '<div class="d-ep">' +
      '<div class="d-ep-card"><div class="d-ep-icon">▣</div><div class="d-ep-name">' + srcDisp + '</div></div>' +
      '<div class="d-ep-arrow">→</div>' +
      '<div class="d-ep-card"><div class="d-ep-icon">▣</div><div class="d-ep-name">' + tgtDisp + '</div></div>' +
    '</div>' +

    '<div class="d-ep-row">' +
      '<div class="d-cell"><div class="k">' + t('drawer.nodeIp') + '</div><div class="v">' + srcIp + '</div></div>' +
      '<div class="d-cell"><div class="k">' + t('drawer.nodeIp') + '</div><div class="v">' + tgtIp + '</div></div>' +
    '</div>' +
    '<div class="d-ep-row">' +
      '<div class="d-cell"><div class="k">' + t('drawer.interface') + '</div><div class="v">' + srcCp + '</div></div>' +
      '<div class="d-cell"><div class="k">' + t('drawer.interface') + '</div><div class="v">' + tgtCp + '</div></div>' +
    '</div>' +

    '<div class="d-trx">' +
      '<div class="d-tr tx">' +
        '<div class="d-tr-title">' + t('drawer.tx') + ' &uarr;</div>' +
        '<div class="d-tr-val">' + (e.tx_throughput==null?'—':e.tx_throughput.toFixed(2)) + '</div>' +
        '<div class="d-tr-sub">' + t('drawer.tput') + '</div>' +
        '<div class="d-tr-u ' + utilClass(e.tx_util) + '">' + fmtPct(e.tx_util) + ' &nbsp;<span style="color:var(--muted);font-size:10px;font-weight:600">' + t('drawer.util') + '</span></div>' +
      '</div>' +
      '<div class="d-tr rx">' +
        '<div class="d-tr-title">' + t('drawer.rx') + ' &darr;</div>' +
        '<div class="d-tr-val">' + (e.rx_throughput==null?'—':e.rx_throughput.toFixed(2)) + '</div>' +
        '<div class="d-tr-sub">' + t('drawer.tput') + '</div>' +
        '<div class="d-tr-u ' + utilClass(e.rx_util) + '">' + fmtPct(e.rx_util) + ' &nbsp;<span style="color:var(--muted);font-size:10px;font-weight:600">' + t('drawer.util') + '</span></div>' +
      '</div>' +
    '</div>' +

    '<div class="d-trend-card">' +
      '<div class="d-trend-title">' + t('drawer.trend') + ' <span style="margin-left:auto">ⓘ</span></div>' +
      '<div id="drawer-trend" class="d-trend"></div>' +
      '<div class="d-trend-note">' + t('drawer.note') + '</div>' +
    '</div>' +

    (cps.length > 1 ?
      '<div class="d-cps-hint">' + t('drawer.cps') + ' (' + cps.length + ')</div>' +
      '<div class="d-cps">' + cps.map(c =>
        '<div style="background:var(--panel2);border:1px solid var(--line);border-radius:6px;padding:5px 8px;margin-bottom:4px;font-size:11px">' +
        '<div style="font-family:Consolas,monospace;color:var(--muted);margin-bottom:2px">' + (c.cp||'—') + ' &harr; ' + (c.ncp||'—') + '</div>' +
        '<div style="display:flex;justify-content:space-between"><span>TX <b style="color:' + LVL_COLOR[(+c.tx_u)>= THRESHOLDS_T.warning ? 'warning' : (+c.tx_u) >= THRESHOLDS_T.watch ? 'watch' : 'healthy'] + '">' + fmtPct(c.tx_u) + '</b></span>' +
        '<span>RX <b style="color:' + LVL_COLOR[(+c.rx_u)>= THRESHOLDS_T.warning ? 'warning' : (+c.rx_u) >= THRESHOLDS_T.watch ? 'watch' : 'healthy'] + '">' + fmtPct(c.rx_u) + '</b></span></div></div>'
      ).join('') + '</div>' : '') +

    '<div class="d-actions">' +
      '<button class="btn" id="d-btn-locate">' + t('drawer.locate') + '</button>' +
      '<button class="btn" id="d-btn-close">' + t('drawer.close') + '</button>' +
    '</div>';

  el('drawer').classList.add('open');
  el('drawer-mask').classList.add('open');
  el('d-btn-locate').onclick = function(){ locateEdge(e); closeDrawer(); };
  el('d-btn-close').onclick = closeDrawer;
  // 链路级历史趋势：当前只有 1 day 粒度 1 点；用 max(TX,RX) utilization 序列
  renderDrawerTrend(e);
}

function renderDrawerTrend(e){
  if(!drawerTrend) drawerTrend = echarts.init(el('drawer-trend'), APP_THEME==='dark'?'amDark':'amLight', {renderer:'svg'});
  const dates = (DATA && DATA.trends) ? DATA.trends.map(t=>t.date) : [];
  const isSingle = dates.length <= 1;
  // 单点：画一个水平直线表示当前值（占位，等更多日累积自动变成曲线）
  const txData = dates.map(()=>+e.tx_util.toFixed(2));
  const rxData = dates.map(()=>+e.rx_util.toFixed(2));
  const maxData = dates.map(()=>+e.max_util.toFixed(2));
  drawerTrend.setOption({
    tooltip: { trigger: 'axis', backgroundColor:'rgba(3,20,29,0.92)', borderColor:'rgba(25,195,255,0.3)', textStyle:{color:'#e7f3f8'} },
    legend: { data:['TX','RX','Max'], textStyle:{color:curP().muted}, top:0, right:0, textStyle:{color:curP().muted, fontSize:10} },
    grid: { left: 28, right: 8, top: 22, bottom: 20 },
    xAxis: {
      type:'category', data: isSingle ? ['Now'] : dates,
      boundaryGap:false, axisLabel:{color:curP().muted, fontSize:9},
      axisLine:{lineStyle:{color:curP().line||'rgba(255,255,255,.1)'}}
    },
    yAxis: {
      type:'value', max:100, axisLabel:{formatter:'{value}%', color:curP().muted, fontSize:9},
      splitLine:{lineStyle:{color:curP().line||'rgba(255,255,255,.06)'}}
    },
    series: [
      { name:'Max', type:'line', smooth:false, showSymbol:!isSingle, symbolSize:6,
        data: maxData, itemStyle:{color: LVL_COLOR[e.status]}, lineStyle:{width:2, color: LVL_COLOR[e.status]} },
      { name:'TX',  type:'line', smooth:false, showSymbol:!isSingle, symbolSize:5,
        data: txData,  itemStyle:{color:'#ff6b6b'}, lineStyle:{width:1.5, color:'#ff6b6b', type:'dashed'} },
      { name:'RX',  type:'line', smooth:false, showSymbol:!isSingle, symbolSize:5,
        data: rxData,  itemStyle:{color:'#27d39a'}, lineStyle:{width:1.5, color:'#27d39a', type:'dashed'} },
    ],
  }, true);
  setTimeout(function(){ if(drawerTrend) drawerTrend.resize(); }, 50);
}

function closeDrawer(){
  el('drawer').classList.remove('open');
  el('drawer-mask').classList.remove('open');
  selEdge = null;
  selNodeIds = [];
  renderRisks();
  if(chart) renderTopoEcharts();
  if(chart) chart.dispatchAction({ type: 'downplay', seriesIndex: 0 });
  // 释放 drawer 内 ECharts 实例，避免占用与主题切换时残留
  if(drawerTrend){ try { drawerTrend.dispose(); } catch(_){} drawerTrend = null; }
}

/* ============ KPI 卡 → 点击弹表格（Antd dark 风格，复用项目表样式） ============ */
function openKpiModal(kind){
  if(!DATA) return;
  const sites = {}; DATA.nodes.forEach(n => { sites[n.id] = n; });
  const tbody = []; // [label, key, status, count]
  let rowsHTML = '';
  let helpKey = 'kpiModal.helpLink';
  let meta = '';
  if(kind === 'nodes'){
    helpKey = 'kpiModal.helpNodes';
    const list = DATA.nodes.slice().sort((a,b)=>(b.degree||0)-(a.degree||0));
    rowsHTML = '<table class="kpi-tbl"><thead><tr><th class="num">'+t('kpiModal.colNum')+'</th><th>'+t('kpiModal.colSite')+'</th><th>'+t('kpiModal.colIP')+'</th><th>'+t('kpiModal.colDeg')+'</th><th>'+t('kpiModal.colNodeMax')+'</th><th>'+t('kpiModal.colNodeStatus')+'</th></tr></thead><tbody>' +
      list.map((n, i) =>
        '<tr class="kpi-row" data-id="'+n.id+'">' +
        '<td class="num">'+(i+1)+'</td>' +
        '<td>'+(n.site||n.name||'—')+'</td>' +
        '<td class="mono">'+(n.ip||'—')+'</td>' +
        '<td class="mono">'+(n.degree||0)+'</td>' +
        '<td class="pct" style="color:'+(LVL_COLOR[n.status]||LVL_COLOR.unknown)+'">'+(n.max_util==null?'—':n.max_util.toFixed(1)+'%')+'</td>' +
        '<td><span class="kpi-tbl-status" style="background:'+(LVL_COLOR[n.status]||LVL_COLOR.unknown)+'">'+ (LVL_TEXT[n.status]||n.status) +'</span></td>' +
        '</tr>'
      ).join('') +
      '</tbody></table>';
    if(!list.length) rowsHTML = '<div class="kpi-tbl-empty">'+t('kpiModal.empty')+'</div>';
    el('kpi-modal-title').textContent = t('kpi.nodes') + ' · ' + list.length;
    el('kpi-modal-meta').textContent = '';
  } else if(kind === 'max'){
    helpKey = 'kpiModal.helpMax';
    const m = DATA.kpis.max_util_link;
    if(!m){
      rowsHTML = '<div class="kpi-tbl-empty">'+t('kpiModal.empty')+'</div>';
    } else {
      const e = DATA.edges.find(x => x.source===m.source && x.target===m.target) || {};
      const eRev = DATA.edges.find(x => x.source===m.target && x.target===m.source) || {};
      const full = e.source ? e : eRev;
      rowsHTML = '<table class="kpi-tbl"><thead><tr><th>'+t('kpiModal.colSite')+'</th><th>'+t('kpiModal.colIP')+'</th><th></th><th>'+t('kpiModal.colPeer')+'</th><th>'+t('kpiModal.colPeerIP')+'</th><th>'+t('kpiModal.colTX')+'</th><th>'+t('kpiModal.colRX')+'</th><th>'+t('kpiModal.colMax')+'</th><th>'+t('kpiModal.colStatus')+'</th></tr></thead><tbody>' +
        '<tr class="kpi-row" data-src="'+m.source+'" data-dst="'+m.target+'">' +
        '<td>'+(m.source_site||shortName(m.source))+'</td><td class="mono">'+(sites[m.source]&&sites[m.source].ip||'—')+'</td>' +
        '<td style="color:var(--accent);text-align:center">↔</td>' +
        '<td>'+(m.target_site||shortName(m.target))+'</td><td class="mono">'+(sites[m.target]&&sites[m.target].ip||'—')+'</td>' +
        '<td class="pct">'+fmtPct(m.tx_util)+'</td>' +
        '<td class="pct">'+fmtPct(m.rx_util)+'</td>' +
        '<td class="pct" style="color:'+LVL_COLOR.critical+'">'+fmtPct(Math.max(m.tx_util||0, m.rx_util||0))+'</td>' +
        '<td><span class="kpi-tbl-status" style="background:'+LVL_COLOR.critical+'">Critical</span></td>' +
        '</tr></tbody></table>';
    }
    el('kpi-modal-title').textContent = t('kpi.max') + ' — ' + (m?(m.source_site||shortName(m.source))+' → '+(m.target_site||shortName(m.target)):'—');
    el('kpi-modal-meta').textContent = '';
  } else {
    helpKey = 'kpiModal.helpPort';
    let list, titleKey = kind;
    if(kind === 'links'){
      list = DATA.edges.slice().sort((a,b)=>(b.max_util||0)-(a.max_util||0));
    } else {
      list = DATA.edges.filter(e => e.status === kind).sort((a,b)=>(b.max_util||0)-(a.max_util||0));
    }
    rowsHTML = '<table class="kpi-tbl"><thead><tr><th class="num">'+t('kpiModal.colNum')+'</th><th>'+t('kpiModal.colSite')+'</th><th>'+t('kpiModal.colIP')+'</th><th></th><th>'+t('kpiModal.colPeer')+'</th><th>'+t('kpiModal.colPeerIP')+'</th><th>'+t('kpiModal.colTX')+'</th><th>'+t('kpiModal.colRX')+'</th><th>'+t('kpiModal.colMax')+'</th><th>'+t('kpiModal.colStatus')+'</th></tr></thead><tbody>' +
      list.map((e, i) => {
        const s = sites[e.source] || {}, t_ = sites[e.target] || {};
        const sname = (e.source_site||shortName(e.source)) + ' · ' + s.site;
        const tname = (e.target_site||shortName(e.target)) + ' · ' + t_.site;
        return '<tr class="kpi-row" data-src="'+e.source+'" data-dst="'+e.target+'">' +
          '<td class="num">'+(i+1)+'</td>' +
          '<td>'+e.source_site+'</td><td class="mono">'+(s.ip||'—')+'</td>' +
          '<td style="color:var(--accent);text-align:center">↔</td>' +
          '<td>'+e.target_site+'</td><td class="mono">'+(t_.ip||'—')+'</td>' +
          '<td class="pct" style="color:'+LVL_COLOR[(e.tx_util||0)>=85?'critical':(e.tx_util||0)>=70?'warning':(e.tx_util||0)>=50?'watch':'healthy']+'">'+fmtPct(e.tx_util)+'</td>' +
          '<td class="pct" style="color:'+LVL_COLOR[(e.rx_util||0)>=85?'critical':(e.rx_util||0)>=70?'warning':(e.rx_util||0)>=50?'watch':'healthy']+'">'+fmtPct(e.rx_util)+'</td>' +
          '<td class="pct" style="color:'+LVL_COLOR[e.status]+'">'+fmtPct(e.max_util)+'</td>' +
          '<td><span class="kpi-tbl-status" style="background:'+LVL_COLOR[e.status]+'">'+LVL_TEXT[e.status]+'</span></td>' +
          '</tr>';
      }).join('') + '</tbody></table>';
    if(!list.length) rowsHTML = '<div class="kpi-tbl-empty">'+t('kpiModal.empty')+'</div>';
    const ttl = (kind==='links' ? t('kpi.links') : t('kpi.'+kind)) + ' · ' + list.length;
    el('kpi-modal-title').textContent = ttl;
    el('kpi-modal-meta').textContent = '';
  }
  const helpHTML = '<div class="kpi-help">'+t(helpKey)+'</div>';
  el('kpi-modal-body').innerHTML = helpHTML + rowsHTML;
  el('kpi-modal').classList.add('open');
  el('kpi-modal-mask').classList.add('open');
  // 行点击 → 定位拓扑 + 打开抽屉
  el('kpi-modal-body').querySelectorAll('tr.kpi-row').forEach(tr => {
    tr.onclick = function(){
      const src = tr.dataset.src, dst = tr.dataset.dst, id = tr.dataset.id;
      closeKpiModal();
      if(src && dst){
        const full = DATA.edges.find(e => e.source===src && e.target===dst) ||
                     DATA.edges.find(e => e.source===dst && e.target===src);
        if(full) selectEdge(full, true);
      } else if(id){
        // node: 展开卡片（逻辑模式）
        selNodeIds = [id]; renderRisks(); if(chart) renderTopoEcharts();
      }
    };
  });
}
function closeKpiModal(){
  el('kpi-modal').classList.remove('open');
  el('kpi-modal-mask').classList.remove('open');
}

/* 单独定位（不打开抽屉） */
function locateEdge(full){
  const src = findNode(full.source), tgt = findNode(full.target);
  if(!src || !tgt) return;
  try{
    if(layoutMode === 'geo' && leafMap && src.lon != null && tgt.lon != null){
      const cLon = (src.lon + tgt.lon) / 2, cLat = (src.lat + tgt.lat) / 2;
      const span = Math.max(Math.abs(src.lon - tgt.lon), Math.abs(src.lat - tgt.lat)) || 0.4;
      leafMap.setView([cLat, cLon], Math.max(3, Math.min(10, 1.2 / span)));
    } else if(chart){
      // force 模式：读 layout 后的 x/y（force 布局写回 series data）
      const opt = chart.getOption();
      const sd = opt.series && opt.series[0] ? opt.series[0].data : null;
      if(sd){
        const a = sd.find(n => n.id === full.source), b = sd.find(n => n.id === full.target);
        if(a && b && typeof a.x === 'number' && typeof b.x === 'number'){
          chart.setOption({ series: [{ center: [(a.x + b.x) / 2, (a.y + b.y) / 2], zoom: 2.2 }] });
        }
      }
    }
  }catch(e){ console.warn('locateEdge', e); }
}

/* 搜索后自动居中到匹配节点集 */
function autoCenter(nodes){
  if(!nodes || !nodes.length) return;
  if(layoutMode === 'geo' && leafMap){
    const gn = nodes.filter(n => n.lat != null && n.lon != null);
    if(!gn.length) return;
    const bounds = L.latLngBounds(gn.map(n => [n.lat, n.lon]));
    leafMap.fitBounds(bounds, { padding:[60,60] });
  } else if(chart){
    const opt = chart.getOption();
    const sd = opt.series && opt.series[0] ? opt.series[0].data : null;
    if(!sd) return;
    const ids = new Set(nodes.map(n=>n.id));
    const pts = sd.filter(n => ids.has(n.id) && typeof n.x==='number' && typeof n.y==='number');
    if(!pts.length) return;
    let minX=Infinity,maxX=-Infinity,minY=Infinity,maxY=-Infinity;
    pts.forEach(p => { if(p.x<minX)minX=p.x; if(p.x>maxX)maxX=p.x; if(p.y<minY)minY=p.y; if(p.y>maxY)maxY=p.y; });
    const span = Math.max(maxX-minX, maxY-minY, 200);
    chart.setOption({ series: [{ center: [(minX+maxX)/2, (minY+maxY)/2],
      zoom: Math.max(0.8, Math.min(3, 1100 / span)) }] });
  }
}

function resetView(){
  if(layoutMode === 'geo' && leafMap){
    leafMap.setView([-9.7, 6.6], 7);
  } else if(chart){
    const Lc = lastLayout || { centerX: 480, xRange: 960 };
    const w = (chart.getWidth && chart.getWidth()) || 1000;
    const zoom = Math.max(0.4, Math.min(2, w / (Lc.xRange * 1.15)));
    chart.setOption({ series: [{ center: [Lc.centerX, 0], zoom: zoom }] });
  }
}

/* ============ trend / distribution ============ */
function renderTrend(){
  if(!trendChart) trendChart = echarts.init(el('trend'), APP_THEME==='dark'?'amDark':'amLight');
  const tr = DATA ? DATA.trends : [];
  trendChart.setOption({
    tooltip: { trigger: 'axis' },
    legend: { data:[t('trend.avg'), t('trend.max'), t('trend.crit')], textStyle:{color:curP().muted}, top:0, right:0 },
    grid: { left: 40, right: 50, top: 26, bottom: 22 },
    xAxis: { type:'category', data: tr.map(d=>d.date), boundaryGap:false },
    yAxis: [
      { type:'value', name:'%', max:100, axisLabel:{formatter:'{value}%'} },
      { type:'value', name:t('trend.crit'), minInterval:1 }
    ],
    series: [
      { name:t('trend.avg'), type:'line', smooth:true, data: tr.map(d=>d.avg_util),
        itemStyle:{color:'#19c3ff'}, lineStyle:{width:2} },
      { name:t('trend.max'), type:'line', smooth:true, data: tr.map(d=>d.max_util),
        itemStyle:{color:'#ff6b6b'}, lineStyle:{width:2}, areaStyle:{opacity:.08} },
      { name:t('trend.crit'), type:'bar', yAxisIndex:1, data: tr.map(d=>d.critical),
        itemStyle:{color:'rgba(255,107,107,.45)'} },
    ],
  }, true);
}

function renderDist(){
  if(!distChart) distChart = echarts.init(el('dist'), APP_THEME==='dark'?'amDark':'amLight');
  const k = DATA ? DATA.kpis : null;
  const items = [
    { name: t('dist.health'), value: k?k.healthy:0, c:'#27d39a' },
    { name: t('dist.watch'), value: k?k.watch:0, c:'#ffd43b' },
    { name: t('dist.warn'), value: k?k.warning:0, c:'#ff922b' },
    { name: t('dist.crit'), value: k?k.critical:0, c:'#ff6b6b' },
  ];
  distChart.setOption({
    tooltip: { trigger:'item', formatter: p => p.name + '<br/>' + p.value + ' ' + t('tt.units') + ' (' + (p.percent==null?0:p.percent).toFixed(1) + '%)' },
    grid: { left: 8, right: 30, top: 10, bottom: 8, containLabel: true },
    xAxis: { type:'value', minInterval:1 },
    yAxis: { type:'category', data: items.map(i=>i.name), axisLabel:{color:curP().text} },
    series: [{
      type:'bar', barWidth: 14,
      data: items.map(i => ({ value:i.value, itemStyle:{color:i.c}, label:{show:true, position:'right', color:curP().text} })),
    }],
  }, true);
}

/* ============ events ============ */
function refreshLevelFilterUI(){
  const sel = levelFilter || [];
  const all = el('lv-all'); if(all) all.checked = (sel.length === 0);
  ['critical','warning','watch','healthy'].forEach(v => { const c = el('lv-'+v); if(c) c.checked = sel.indexOf(v) >= 0; });
  const btn = el('btn-level');
  if(btn) btn.textContent = (sel.length === 0 ? t('topo.lvlAll') : sel.map(s => LVL_TEXT[s]||s).join(' · ')) + ' ▾';
}
function syncGeoLabelBtn(){
  const b = el('btn-geo-label');
  if(!b) return;
  b.classList.toggle('active', geoShowLabels);
  b.style.display = (layoutMode === 'geo') ? 'inline-block' : 'none';
}
el('btn-force').onclick = function(){ layoutMode='force'; el('btn-force').classList.add('active'); el('btn-geo').classList.remove('active'); syncGeoLabelBtn(); renderTopo(); };
el('btn-geo').onclick = function(){ layoutMode='geo'; el('btn-geo').classList.add('active'); el('btn-force').classList.remove('active'); syncGeoLabelBtn(); renderTopo(); };
['lv-all','lv-critical','lv-warning','lv-watch','lv-healthy'].forEach(function(id){
  el(id).onchange = function(){
    if(id === 'lv-all'){ ['lv-critical','lv-warning','lv-watch','lv-healthy'].forEach(x => el(x).checked = false); }
    else { el('lv-all').checked = false; }
    levelFilter = ['critical','warning','watch','healthy'].filter(v => el('lv-'+v).checked);
    refreshLevelFilterUI();
    renderTopo();
  };
});
el('btn-level').onclick = function(e){ e.stopPropagation(); const m = el('level-menu'); m.style.display = m.style.display === 'block' ? 'none' : 'block'; };
document.addEventListener('click', function(){ const m = el('level-menu'); if(m) m.style.display = 'none'; });
el('btn-geo-label').onclick = function(){
  geoShowLabels = !geoShowLabels;
  syncGeoLabelBtn();
  if(layoutMode === 'geo' && leafMap) renderGeoNodes();
};
el('chk-label').onchange = function(){ showLabel = this.checked; renderTopo(); };
el('chk-access').onchange = function(){ collapseAccess = !this.checked; renderTopo(); };
el('inp-search').oninput = debounce(function(){
  const q = (el('inp-search').value||'').trim();
  if(!q) resetView();
  renderTopo();
}, 300);
el('risk-search').oninput = debounce(renderRisks, 200);
el('btn-refresh').onclick = function(){ loadData(true); };
refreshLevelFilterUI();
syncGeoLabelBtn();
el('drawer-close').onclick = closeDrawer;
el('drawer-mask').onclick = closeDrawer;
el('kpi-modal-close').onclick = closeKpiModal;
el('kpi-modal-mask').onclick = closeKpiModal;
document.addEventListener('keydown', function(ev){
  if(ev.key === 'Escape'){ closeDrawer(); closeKpiModal(); }
});
document.querySelectorAll('[data-kpi]').forEach(function(c){
  c.addEventListener('click', function(){ openKpiModal(c.dataset.kpi); });
});

/* ============ 全屏 / 最大化 ============ */
el('btn-fs').onclick = function(){
  try{
    if(!document.fullscreenElement){
      const d = document.documentElement;
      (d.requestFullscreen || d.webkitRequestFullscreen || d.msRequestFullscreen || function(){}).call(d);
    } else {
      (document.exitFullscreen || document.webkitExitFullscreen || function(){}).call(document);
    }
  }catch(e){ console.warn('fullscreen', e); }
};
document.addEventListener('fullscreenchange', function(){
  const fs = !!document.fullscreenElement;
  el('btn-fs').textContent = fs ? '🗗' : '⛶';
  el('btn-fs').title = fs ? t('fs.exit') : t('fs.title');
  setTimeout(function(){ if(chart) chart.resize(); if(trendChart) trendChart.resize(); if(distChart) distChart.resize(); }, 80);
});
el('btn-topo-max').onclick = function(){
  const w = el('topo-wrap');
  const isMax = w.classList.toggle('max');
  el('btn-topo-max').textContent = isMax ? '🗗' : '⛶';
  el('btn-topo-max').title = isMax ? t('fs.restore') : t('fs.max');
  setTimeout(function(){ if(chart) chart.resize(); }, 80);
};

function debounce(fn, ms){ let t; return function(){ clearTimeout(t); t = setTimeout(fn, ms); }; }

// 地理模式改用 Leaflet + OSM 在线瓦片，不再依赖离线 Liberia GeoJSON

/* ============ resize ============ */
window.addEventListener('resize', function(){
  if(chart) chart.resize();
  if(trendChart) trendChart.resize();
  if(distChart) distChart.resize();
  if(leafMap) leafMap.invalidateSize();
});

/* ============ boot ============ */
applyTheme(APP_THEME);
window.addEventListener('load', function(){ loadData(false); });
</script>
</body>
</html>
