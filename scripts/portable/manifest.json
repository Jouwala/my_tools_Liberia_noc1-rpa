      "why": "统一门户（含 v3 问答助手挂件、静态壳、server、scripts/whatsapp_analysis）",
      "exclude_root": ["log", "TMP", ".git", "auth-data"],
      "exclude_any": ["node_modules", "_quarantine_*", "_bak_*", "__pycache__", ".pytest_cache"],
