  "patterns": [
    {
      "regex": "(?i)FROM\\s+sqlite_master|sqlite_master\\s+WHERE",
      "desc": "裸 sqlite_master 查询（应走 dialect_helpers.list_table_names）",
      "mode": "fail"
    },
    {
      "regex": "(?i)INSERT\\s+OR\\s+(REPLACE|IGNORE)",
      "desc": "sqlite 专属 upsert 语法（确认已在 DB_MODE/sqlite 守卫分支内，否则改 ON CONFLICT）",
      "mode": "warn"
    },
    {
      "regex": "(?<![.\\w])rowid(?!\\w)",
      "desc": "sqlite 隐式 rowid（确认已有 pg 分支如 ctid，否则改真实主键）",
      "mode": "warn"
    },
    {
      "regex": "\\.lastrowid\\b",
      "desc": "lastrowid 在 psycopg2 下不可靠（pg 需 RETURNING）",
      "mode": "warn"
    },
    {
      "regex": "\\.to_sql\\(",
      "desc": "pandas to_sql（确认 conn 为 SQLAlchemy connectable 或已走 dialect_helpers.write_df）",
      "mode": "warn"
    },
    {
      "regex": "AUTOINCREMENT",
      "desc": "sqlite DDL（确认已在 DB_MODE 分支或 PG 用 IDENTITY 等价）",
      "mode": "warn"
    }
  ]
}
