{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/start-wa-service.mjs",
    "dev": "vite --port=9267 --host=0.0.0.0",
    "build": "node scripts/check-i18n.mjs && node scripts/check-v3-team-i18n.mjs && vite build",
    "prestart": "npm run build",
    "start": "tsx server/index.ts",
    "prepreview": "node scripts/start-wa-service.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "lint:shells": "tsc -p v1/olbrportal/tsconfig.json",
    "test": "node --import tsx --test src/utils/groups.test.ts src/utils/format.test.ts server/portalDefault.test.ts server/teamScopeDb.test.ts",
    "verify:readiness": "node scripts/verify-readiness.mjs",
    "check:team-scope": "node scripts/check-team-scope.mjs",
    "check:clean": "node scripts/check-cleanliness.mjs audit",
    "check:docs": "node scripts/check-doc-consistency.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:v3-i18n": "node scripts/check-v3-team-i18n.mjs",
    "//setup:hooks": "把 Git 提交前守卫指向仓库内的 .githooks/（core.hooksPath）。钩子文件随仓库分发 —— 换机器/克隆后跑一次即可生效。详见根 AGENTS.md「提交前守卫」。",
    "setup:hooks": "node ../scripts/setup-git-hooks.mjs",
    "tmp:clean": "node scripts/check-cleanliness.mjs clean",
    "tmp:clean:apply": "node scripts/check-cleanliness.mjs clean --apply"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^10.4.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.2",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
