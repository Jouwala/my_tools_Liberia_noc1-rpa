# WhatsApp @Me Assistant 本地服务配置
# 数据仅存本地；唯一外发路径是下面配置的 AI API。

# 服务监听端口
PORT=9268

# ---- AI API（二选一，未配置时服务降级为规则提取，不报错）----
# openai = 任意 OpenAI 兼容接口（含公司内网网关）；gemini = Google Gemini REST
AI_API_TYPE=
# 例：openai 兼容 -> https://api.openai.com/v1 或公司网关基址（到 /v1 为止）
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Gemini 专用（AI_API_TYPE=gemini 时）
GEMINI_MODEL=gemini-2.0-flash

# ---- 报告 ----
# 每天生成 Daily Report 的 cron 表达式，默认 08:00
REPORT_CRON=0 8 * * *

# ---- 我的名字（@我 匹配用，扩展首次运行会自动检测并缓存，可在此覆盖）----
SELF_NAME=
